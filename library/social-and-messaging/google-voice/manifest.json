{
  "manifest_version": "0.3",
  "name": "google-voice-pp-mcp",
  "display_name": "Google Voice",
  "version": "0.1.0",
  "description": "Read Google Voice through ordinary HTTP and recover evidence from a local message mirror.",
  "author": {
    "name": "CLI Printing Press"
  },
  "license": "Apache-2.0",
  "server": {
    "type": "binary",
    "entry_point": "bin/google-voice-pp-mcp",
    "mcp_config": {
      "command": "${__dirname}/bin/google-voice-pp-mcp",
      "args": []
    }
  },
  "compatibility": {
    "claude_desktop": ">=1.0.0",
    "platforms": [
      "darwin",
      "linux",
      "win32"
    ]
  }
}
