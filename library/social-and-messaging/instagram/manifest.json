{
  "manifest_version": "0.3",
  "name": "instagram-pp-mcp",
  "display_name": "Instagram",
  "version": "4.2.2",
  "description": "Single-binary Instagram archiver — local SQLite catalog, FTS over captions and Instagram-generated alt-text, and an MCP server in the same binary.",
  "author": {
    "name": "CLI Printing Press"
  },
  "license": "Apache-2.0",
  "server": {
    "type": "binary",
    "entry_point": "bin/instagram-pp-mcp",
    "mcp_config": {
      "command": "${__dirname}/bin/instagram-pp-mcp",
      "args": []
    }
  },
  "compatibility": {
    "claude_desktop": ">=1.0.0",
    "platforms": [
      "darwin",
      "linux",
      "win32"
    ]
  }
}
