{
  "manifest_version": "0.3",
  "name": "telegram-pp-mcp",
  "display_name": "Telegram Bot",
  "version": "4.2.2",
  "description": "Telegram Bot API for building bots - send messages, manage chats, webhooks, stickers",
  "author": {
    "name": "CLI Printing Press"
  },
  "license": "Apache-2.0",
  "server": {
    "type": "binary",
    "entry_point": "bin/telegram-pp-mcp",
    "mcp_config": {
      "command": "${__dirname}/bin/telegram-pp-mcp",
      "args": [],
      "env": {
        "TELEGRAM_BOT_TOKEN": "${user_config.telegram_bot_token}"
      }
    }
  },
  "user_config": {
    "telegram_bot_token": {
      "type": "string",
      "title": "TELEGRAM_BOT_TOKEN",
      "description": "Sets TELEGRAM_BOT_TOKEN for the Telegram Bot MCP server.",
      "sensitive": true,
      "required": true
    }
  },
  "compatibility": {
    "claude_desktop": ">=1.0.0",
    "platforms": [
      "darwin",
      "linux",
      "win32"
    ]
  }
}
