{
  "manifest_version": "0.3",
  "name": "omakase-pp-mcp",
  "display_name": "OMAKASE",
  "version": "0.1.0",
  "description": "Discover premium Japanese restaurants with source courses, release rules and honest availability states.",
  "author": {
    "name": "CLI Printing Press"
  },
  "license": "Apache-2.0",
  "server": {
    "type": "binary",
    "entry_point": "bin/omakase-pp-mcp",
    "mcp_config": {
      "command": "${__dirname}/bin/omakase-pp-mcp",
      "args": []
    }
  },
  "compatibility": {
    "claude_desktop": ">=1.0.0",
    "platforms": [
      "darwin",
      "linux",
      "win32"
    ]
  }
}
