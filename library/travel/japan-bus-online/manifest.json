{
  "manifest_version": "0.3",
  "name": "japan-bus-online-pp-mcp",
  "display_name": "Japan Bus Online",
  "version": "1.0.0",
  "description": "Read-only bus routes, dated inventory and source-grounded fares.",
  "author": {
    "name": "CLI Printing Press"
  },
  "license": "Apache-2.0",
  "server": {
    "type": "binary",
    "entry_point": "bin/japan-bus-online-pp-mcp",
    "mcp_config": {
      "command": "${__dirname}/bin/japan-bus-online-pp-mcp",
      "args": []
    }
  },
  "compatibility": {
    "claude_desktop": ">=1.0.0",
    "platforms": [
      "darwin",
      "linux",
      "win32"
    ]
  }
}
