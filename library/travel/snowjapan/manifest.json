    "entry_point": "bin/snowjapan-pp-mcp",
    "mcp_config": {
      "command": "${__dirname}/bin/snowjapan-pp-mcp",
      "args": []
    }
  },
  "compatibility": {
    "claude_desktop": ">=1.0.0",
    "platforms": [
      "darwin",
      "linux",
      "win32"
    ]
  }
}
