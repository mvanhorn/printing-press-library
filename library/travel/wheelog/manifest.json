{
  "manifest_version": "0.3",
  "name": "wheelog-pp-mcp",
  "display_name": "WheeLog",
  "version": "0.1.0",
  "description": "Find and compare recorded accessibility facts with gaps and conflicting reports visible.",
  "author": {
    "name": "CLI Printing Press"
  },
  "license": "Apache-2.0",
  "server": {
    "type": "binary",
    "entry_point": "bin/wheelog-pp-mcp",
    "mcp_config": {
      "command": "${__dirname}/bin/wheelog-pp-mcp",
      "args": []
    }
  },
  "compatibility": {
    "claude_desktop": ">=1.0.0",
    "platforms": [
      "darwin",
      "linux",
      "win32"
    ]
  }
}
