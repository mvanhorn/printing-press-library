{
  "manifest_version": "0.3",
  "name": "airbnb-outreach-pp-mcp",
  "display_name": "Airbnb",
  "version": "0.1.0",
  "description": "Script Airbnb's real logged-in surface — search stays, contact hosts with templated messages and photos, and keep an offline archive of every conversation.",
  "author": {
    "name": "CLI Printing Press"
  },
  "license": "Apache-2.0",
  "server": {
    "type": "binary",
    "entry_point": "bin/airbnb-outreach-pp-mcp",
    "mcp_config": {
      "command": "${__dirname}/bin/airbnb-outreach-pp-mcp",
      "args": []
    }
  },
  "compatibility": {
    "claude_desktop": ">=1.0.0",
    "platforms": [
      "darwin",
      "linux",
      "win32"
    ]
  }
}
