+func TestRouteValidation(t *testing.T) {
+	cases := []struct {
+		name   string
+		change func(*RouteOptions)
+		valid  bool
+	}{
+		{"normal", func(o *RouteOptions) {}, true},
+		{"arrival", func(o *RouteOptions) {
