+type RouteAlternative struct {
+	ID                 string     `json:"id"`
+	StandardJPY        *int       `json:"standard_jpy"`
+	ETCJPY             *int       `json:"etc_jpy"`
+	ETC2JPY            *int       `json:"etc2_jpy"`
