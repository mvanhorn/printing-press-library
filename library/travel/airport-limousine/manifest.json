{
  "manifest_version": "0.3",
  "name": "airport-limousine-pp-mcp",
  "display_name": "Airport Limousine",
  "version": "0.1.0",
  "description": "Plan Tokyo airport buses with exact terminals, dated fares and explicit travel-time uncertainty.",
  "author": {
    "name": "CLI Printing Press"
