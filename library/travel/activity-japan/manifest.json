{
  "manifest_version": "0.3",
  "name": "activity-japan-pp-mcp",
  "display_name": "Activity Japan",
  "version": "0.1.0",
  "description": "Source-backed Japan experiences with explicit plan, price, language and availability evidence.",
  "author": {
    "name": "CLI Printing Press"
  },
  "license": "Apache-2.0",
  "server": {
