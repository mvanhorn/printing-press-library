          },
          "happy_args": ""
        },
        "detail": {
          "method": "GET",
          "path": "/maps/{id}",
          "description": "Read exact public source detail",
          "params": [
            {
              "name": "id",
              "type": "int",
              "description": "Exact first-party source identifier",
              "default": 77,
              "required": true
            }
          ],
          "response": {
            "type": "object",
            "item": "Envelope"
          },
          "happy_args": "--id=77"
        }
      }
    },
    "source_course": {
      "description": "Internal source contract; use focused hiking commands for compact evidence",
      "endpoints": {
        "search": {
          "method": "GET",
          "path": "/model_courses/",
          "description": "Read one bounded source result page",
          "params": [
            {
              "name": "name",
              "type": "string",
              "description": "Source model-course name substring",
              "default": "高尾山"
            },
            {
              "name": "page",
              "type": "int",
              "description": "One-based source result page",
              "default": 1
            },
            {
              "name": "per",
              "type": "int",
              "description": "Bounded source page size, maximum twenty",
              "default": 5
            }
          ],
          "response": {
            "type": "object",
            "item": "Envelope"
          },
          "happy_args": "",
          "pagination": {
            "type": "page",
            "limit_param": "per",
            "cursor_param": "page",
            "next_cursor_path": "meta.next_page"
          },
          "response_path": "model_courses"
        },
        "detail": {
          "method": "GET",
          "path": "/model_courses/{id}",
          "description": "Read exact public source detail",
          "params": [
            {
              "name": "id",
              "type": "int",
              "description": "Exact first-party source identifier",
              "default": 1771,
              "required": true
            }
          ],
          "response": {
            "type": "object",
            "item": "Envelope"
          },
          "happy_args": "--id=1771"
        }
