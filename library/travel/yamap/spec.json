          "happy_args": ""
        },
        "detail": {
          "method": "GET",
          "path": "/activities/{id}",
          "description": "Read exact public source detail",
          "params": [
            {
              "name": "id",
              "type": "int",
              "description": "Exact first-party source identifier",
              "default": 51497803,
              "required": true
            }
          ],
          "response": {
            "type": "object",
            "item": "Envelope"
          },
          "happy_args": "--id=51497803"
        }
      }
    },
    "source_map": {
      "description": "Internal source contract; use focused hiking commands for compact evidence",
      "endpoints": {
        "search": {
          "method": "GET",
          "path": "/maps/search",
          "description": "Read one bounded source result page",
          "params": [
            {
              "name": "keyword",
              "type": "string",
              "description": "Japanese mountain name or report text search",
              "default": "高尾山"
            },
            {
              "name": "page",
              "type": "int",
              "description": "One-based source result page",
              "default": 1
            },
            {
              "name": "per",
              "type": "int",
              "description": "Bounded source page size, maximum twenty",
              "default": 5
            }
          ],
          "response": {
            "type": "object",
