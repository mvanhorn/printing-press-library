+					}
+				}
+			}
+		default:
+			return nil, fail(5, "Weathernews inventory schema changed")
+		}
+	}
+	if !inventoryFound {
+		return nil, fail(5, "Weathernews seasonal inventory is missing; use a prefecture or keyword search")
+	}
