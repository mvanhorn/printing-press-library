+	for _, entry := range data {
+		v := object(entry)
+		d := object(v["data"])
+		var pl any
+		if k := object(d["spotKanaSortedList"]); k != nil {
+			pl = k["pointlist"]
+		} else {
+			pl = d["pointlist"]
+		}
+		if pl == nil {
+			continue
+		}
+		inventoryFound = true
+		providerFetched = providerTime(v["fetchedAt"])
+		switch x := pl.(type) {
+		case []any:
+			for _, z := range x {
+				rows = append(rows, object(z))
+			}
+		case map[string]any:
+			for _, z := range x {
+				if list, ok := z.([]any); ok {
+					for _, a := range list {
