+	items := []any{}
+	terms := strings.Fields(strings.ToLower(query))
+	for _, r := range rows {
+		id := str(first(r, "spotid", "lcid"))
+		name := str(first(r, "pointname", "name"))
+		if !idRE.MatchString(id) || name == "" {
+			return nil, fail(5, "season inventory identity changed")
+		}
+		if seen[id] {
+			continue
+		}
+		seen[id] = true
