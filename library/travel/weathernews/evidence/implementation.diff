+	}
+	for _, x := range fields {
+		date := dateEvidence(report[x.field], year)
+		enabled, _ := report[x.flag].(bool)
+		state := "not_available"
+		if visibility == "source_hidden" {
+			state = "not_publicly_displayed"
+			date = nil
+			enabled = false
+		}
+		if season["updates_ended"] == true {
+			state = "season_ended"
+		} else if enabled && date != nil {
+			state = "available"
+		}
