+// liveDogfoodUseDryRun separates private fixture permission from public MCP
+// hints. Only an explicitly approved default local fixture may execute.
+func liveDogfoodUseDryRun(command liveDogfoodCommand, allowDestructive bool) bool {
+	if !liveDogfoodCommandMutation(command).mutating || !commandSupportsDryRun(command.Help) {
+		return false
+	}
+	if !allowDestructive || !annotationIsTrueValue(command.Annotations["pp:fixture-local-write"]) {
+		return true
+	}
+	if method := strings.ToUpper(strings.TrimSpace(command.Annotations[endpointMethodAnnotation])); method == "POST" || method == "PUT" || method == "PATCH" || method == "DELETE" {
+		return true
+	}
+	args, ok, _ := liveDogfoodHappyArgsParsed(command)
+	if !ok {
+		return true
+	}
+	for _, arg := range args {
+		for _, name := range []string{"--file", "--overwrite", "--deliver"} {
+			if arg == name || strings.HasPrefix(arg, name+"=") {
+				return true
+			}
+		}
+	}
+	return false
+}
