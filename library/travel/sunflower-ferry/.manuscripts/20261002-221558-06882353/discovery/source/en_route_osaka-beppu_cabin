  const headerHeight = 140; // ヘッダーの高さに合わせて調整
  const hash = window.location.hash;

  if (hash) {
    const target = $(hash);
    if (target.length) {
      setTimeout(function() {
        const position = target.offset().top - headerHeight;
        $('html, body').animate({ scrollTop: position }, 300);
      }, 10); // ページ読み込み後に遅延で処理
    }
  }
});
</script>
