{
  "api_name": "semrush",
  "base_url": "https://api.semrush.com",
  "description": "Semrush CLI — Domain Overview, organic keyword research, and backlink intelligence via the Semrush public API",
  "mcp_ready": "full",
  "http_transport": "standard",
  "auth": {
    "type": "api_key",
    "header": "key",
    "in": "query",
    "env_vars": [
      "SEMRUSH_API_KEY"
    ],
    "env_var_specs": [
      {
        "name": "SEMRUSH_API_KEY",
        "kind": "per_call",
        "required": true,
        "sensitive": true,
        "inferred": true
      }
    ]
  },
  "required_headers": [],
  "tools": [
    {
      "name": "backlinks_overview",
      "description": "Backlink count, referring domains, Authority Score. Required: type (default: backlinks_overview), target. Optional: target_type (default: root_domain).",
      "method": "GET",
      "path": "/analytics/v1/",
      "params": [
        {
          "name": "type",
          "type": "string",
          "location": "query",
          "required": true
        },
        {
          "name": "target",
          "type": "string",
          "location": "path",
          "description": "Target domain or URL",
          "required": true
        },
        {
          "name": "target_type",
          "type": "string",
          "location": "query",
          "description": "root_domain, domain, or url"
        }
      ]
    },
    {
      "name": "domain_organic_competitors",
      "description": "Domains ranking for the same keywords as the target — organic competitors. Required: type (default: domain_organic_organic), domain. Optional: database (default: us), display_limit (default: 50).",
      "method": "GET",
      "path": "/",
      "params": [
        {
          "name": "type",
          "type": "string",
          "location": "query",
          "required": true
        },
        {
          "name": "domain",
          "type": "string",
          "location": "path",
          "description": "Target domain",
          "required": true
        },
        {
          "name": "database",
          "type": "string",
          "location": "query"
        },
        {
          "name": "display_limit",
          "type": "int",
          "location": "query"
        }
      ]
    },
    {
      "name": "domain_organic_keywords",
      "description": "Keywords a domain ranks for in organic Google search results. Required: type (default: domain_organic), domain. Optional: database (default: us), display_limit (default: 100).",
      "method": "GET",
      "path": "/",
      "params": [
        {
          "name": "type",
          "type": "string",
          "location": "query",
          "description": "Report type",
          "required": true
        },
        {
          "name": "domain",
          "type": "string",
          "location": "path",
          "description": "Target domain",
          "required": true
        },
        {
          "name": "database",
          "type": "string",
          "location": "query",
          "description": "Country database code"
        },
        {
          "name": "display_limit",
          "type": "int",
          "location": "query",
          "description": "Max keywords to return (default 10, max 100000)"
        }
      ]
    },
    {
      "name": "domain_organic_pages",
      "description": "Top organic landing pages and their ranking keywords for a domain. Required: type (default: domain_organic_pages), domain. Optional: database (default: us), display_limit (default: 100).",
      "method": "GET",
      "path": "/",
      "params": [
        {
          "name": "type",
          "type": "string",
          "location": "query",
          "required": true
        },
        {
          "name": "domain",
          "type": "string",
          "location": "path",
          "description": "Target domain",
          "required": true
        },
        {
          "name": "database",
          "type": "string",
          "location": "query"
        },
        {
          "name": "display_limit",
          "type": "int",
          "location": "query"
        }
      ]
    },
    {
      "name": "domain_overview",
      "description": "Domain overview (organic + paid traffic, keyword count, traffic cost) for a target domain. Required: type (default: domain_overview), domain. Optional: database (default: us).",
      "method": "GET",
      "path": "/",
      "params": [
        {
          "name": "type",
          "type": "string",
          "location": "query",
          "description": "Report type (domain_overview, domain_ranks)",
          "required": true
        },
        {
          "name": "domain",
          "type": "string",
          "location": "path",
          "description": "Target domain (e.g. example.com)",
          "required": true
        },
        {
          "name": "database",
          "type": "string",
          "location": "query",
          "description": "Country database code (us, uk, au, etc.)"
        }
      ]
    },
    {
      "name": "keyword_difficulty",
      "description": "Keyword difficulty (KD%) — chance of ranking on first SERP page. Required: type (default: phrase_kdi), phrase. Optional: database (default: us).",
      "method": "GET",
      "path": "/",
      "params": [
        {
          "name": "type",
          "type": "string",
          "location": "query",
          "required": true
        },
        {
          "name": "phrase",
          "type": "string",
          "location": "path",
          "description": "Keyword phrase",
          "required": true
        },
        {
          "name": "database",
          "type": "string",
          "location": "query"
        }
      ]
    },
    {
      "name": "keyword_overview",
      "description": "Volume, CPC, KD, competition for a single keyword. Required: type (default: phrase_this), phrase. Optional: database (default: us).",
      "method": "GET",
      "path": "/",
      "params": [
        {
          "name": "type",
          "type": "string",
          "location": "query",
          "required": true
        },
        {
          "name": "phrase",
          "type": "string",
          "location": "path",
          "description": "Keyword phrase to look up",
          "required": true
        },
        {
          "name": "database",
          "type": "string",
          "location": "query"
        }
      ]
    },
    {
      "name": "keyword_questions",
      "description": "Question-style keywords containing the seed phrase (great for content SEO). Required: type (default: phrase_questions), phrase. Optional: database (default: us), display_limit (default: 100).",
      "method": "GET",
      "path": "/",
      "params": [
        {
          "name": "type",
          "type": "string",
          "location": "query",
          "required": true
        },
        {
          "name": "phrase",
          "type": "string",
          "location": "path",
          "description": "Seed phrase",
          "required": true
        },
        {
          "name": "database",
          "type": "string",
          "location": "query"
        },
        {
          "name": "display_limit",
          "type": "int",
          "location": "query"
        }
      ]
    },
    {
      "name": "keyword_related",
      "description": "Related keywords (semantic variants) for a seed phrase. Required: type (default: phrase_related), phrase. Optional: database (default: us), display_limit (default: 100).",
      "method": "GET",
      "path": "/",
      "params": [
        {
          "name": "type",
          "type": "string",
          "location": "query",
          "required": true
        },
        {
          "name": "phrase",
          "type": "string",
          "location": "path",
          "description": "Seed phrase",
          "required": true
        },
        {
          "name": "database",
          "type": "string",
          "location": "query"
        },
        {
          "name": "display_limit",
          "type": "int",
          "location": "query"
        }
      ]
    }
  ]
}
