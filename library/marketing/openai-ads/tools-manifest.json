{
  "api_name": "openai-ads",
  "base_url": "https://api.ads.openai.com/v1",
  "description": "The first OpenAI Ads client that can write, and the only one that keeps local history.",
  "mcp_ready": "full",
  "http_transport": "standard",
  "auth": {
    "type": "bearer_token",
    "header": "Authorization",
    "env_vars": [
      "OPENAI_ADS_API_KEY",
      "OPENAI_ADS_CONVERSIONS_API_KEY"
    ],
    "env_var_specs": [
      {
        "name": "OPENAI_ADS_API_KEY",
        "kind": "per_call",
        "required": true,
        "sensitive": true,
        "description": "Ads API key from Ads Manager \u003e Settings. Scoped to one ad account. NOT the Conversions API key from Ads Manager \u003e Conversions (that one returns 403 Unauthorized to read ads data)."
      },
      {
        "name": "OPENAI_ADS_CONVERSIONS_API_KEY",
        "kind": "per_call",
        "required": false,
        "sensitive": true,
        "description": "Optional. Conversions API key from Ads Manager \u003e Conversions, scoped to one conversion event in a data source. Only needed for server-side conversion event ingestion; it cannot read ads data."
      }
    ]
  },
  "required_headers": [],
  "tools": [
    {
      "name": "ad-account_activate-method",
      "description": "Activate the ad account. Returns the new AdAccountResource.",
      "method": "POST",
      "path": "/ad_account/activate",
      "params": []
    },
    {
      "name": "ad-account_get-insights-method",
      "description": "Get ad account insights aggregated by time granularity. Optional: time_granularity, aggregation_level, limit (plus 9 more). Returns array of InsightItemBody.",
      "method": "GET",
      "path": "/ad_account/insights",
      "params": [
        {
          "name": "time_granularity",
          "type": "string",
          "location": "query",
          "description": "Time bucket size. `none` returns one bucket for the requested time range. Segmented requests..."
        },
        {
          "name": "aggregation_level",
          "type": "string",
          "location": "query",
          "description": "Entity grain inside the endpoint scope; it does not widen the endpoint scope."
        },
        {
          "name": "limit",
          "type": "int",
          "location": "query",
          "description": "Maximum number of rows to return. Defaults to 20."
        },
        {
          "name": "before",
          "type": "string",
          "location": "query",
          "description": "Before"
        },
        {
          "name": "after",
          "type": "string",
          "location": "query",
          "description": "After"
        },
        {
          "name": "time_ranges",
          "type": "array",
          "location": "query",
          "description": "Report window filter. Send one JSON-encoded `unix_range`, `hour_range`, or `date_range`..."
        },
        {
          "name": "filters",
          "type": "array",
          "location": "query",
          "description": "Row filters encoded as JSON strings."
        },
        {
          "name": "fields",
          "type": "array",
          "location": "query",
          "description": "Additional row keys to return."
        },
        {
          "name": "sort",
          "type": "array",
          "location": "query",
          "description": "Row ordering encoded as JSON strings with `field` and `direction`."
        },
        {
          "name": "segments",
          "type": "array",
          "location": "query",
          "description": "Optional extra group-by dimension for enabled ad accounts."
        },
        {
          "name": "override_segment_group_order",
          "type": "array",
          "location": "query",
          "description": "Order of the aggregation level and requested segment. Include each exactly once."
        },
        {
          "name": "includes",
          "type": "array",
          "location": "query",
          "description": "Optional result expansion."
        }
      ]
    },
