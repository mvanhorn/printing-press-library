{
  "api_name": "screencloud",
  "base_url": "https://graphql.us.screencloud.com",
  "description": "A Playgrounds release and fleet-operations CLI that understands both Studio and the app content service.",
  "mcp_ready": "full",
  "http_transport": "standard",
  "auth": {
    "type": "bearer_token",
    "header": "Authorization",
    "format": "Bearer {SCREENCLOUD_API_KEY}",
    "env_vars": [
      "SCREENCLOUD_API_KEY"
    ],
    "env_var_specs": [
      {
        "name": "SCREENCLOUD_API_KEY",
        "kind": "per_call",
        "required": true,
        "sensitive": true,
        "inferred": true
      }
    ]
  },
  "required_headers": [],
  "tools": [
    {
      "name": "graphql_request",
      "description": "Execute a Studio GraphQL document with optional variables. Required: query. Optional: variables. Returns the new GraphQLResponse.",
      "method": "POST",
      "path": "/graphql",
      "params": [
        {
          "name": "query",
          "type": "string",
          "location": "body",
          "description": "GraphQL document",
          "required": true
        },
        {
          "name": "variables",
          "type": "object",
          "location": "body",
          "description": "GraphQL variables as JSON"
        }
      ]
    }
  ]
}
