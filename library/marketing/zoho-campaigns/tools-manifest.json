    {
      "name": "tags_associate",
      "description": "Attach a tag to a contact. Required: tagName, lead_email. Optional: resfmt (default: JSON).",
      "method": "GET",
      "path": "/tag/associate",
      "params": [
        {
          "name": "resfmt",
          "type": "string",
          "location": "query",
          "description": "Response format (JSON)"
        },
        {
          "name": "tagName",
          "type": "string",
