{
  "manifest_version": "0.3",
  "name": "tag-helpdesk-pp-mcp",
  "display_name": "Tag Helpdesk",
  "version": "4.6.1",
  "description": "Tag Helpdesk API surface as MCP tools.",
  "author": {
    "name": "CLI Printing Press"
  },
  "license": "Apache-2.0",
  "server": {
    "type": "binary",
    "entry_point": "bin/tag-helpdesk-pp-mcp",
    "mcp_config": {
      "command": "${__dirname}/bin/tag-helpdesk-pp-mcp",
      "args": [],
      "env": {
        "TAG_HELPDESK_API_KEY": "${user_config.tag_helpdesk_api_key}"
      }
    }
  },
  "user_config": {
    "tag_helpdesk_api_key": {
      "type": "string",
      "title": "TAG_HELPDESK_API_KEY",
      "description": "Sets TAG_HELPDESK_API_KEY for the Tag Helpdesk MCP server.",
      "sensitive": true,
      "required": true
    }
  },
  "compatibility": {
    "claude_desktop": ">=1.0.0",
    "platforms": [
      "darwin",
      "linux",
      "win32"
    ]
  }
}
