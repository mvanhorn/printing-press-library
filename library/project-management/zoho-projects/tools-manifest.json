      "params": [
        {
          "name": "portal_id",
          "type": "string",
          "location": "path",
          "description": "Portal id",
          "required": true
        },
        {
          "name": "index",
          "type": "int",
          "location": "query",
          "description": "Index"
        },
        {
          "name": "range",
          "type": "int",
          "location": "query",
          "description": "Range"
        },
        {
          "name": "status",
