      "path": "/api/v3/portal/{portal_id}/issues/my",
      "params": [
        {
          "name": "portal_id",
          "type": "string",
          "location": "path",
          "description": "Portal id",
          "required": true
        }
      ]
    },
    {
      "name": "issues_list-portal",
      "description": "List issues across the portal. Required: portal_id. Optional: index, range, status (plus 1 more). Returns the IssuesListPortalResponse.",
