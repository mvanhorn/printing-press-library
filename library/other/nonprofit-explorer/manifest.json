{
  "manifest_version": "0.3",
  "name": "nonprofit-explorer-pp-mcp",
  "display_name": "Propublica Nonprofit Explorer",
  "version": "2.0.0",
  "description": "Look up US nonprofits and their IRS Form 990 financials via ProPublica's Nonprofit Explorer API.",
  "author": {
    "name": "CLI Printing Press"
  },
  "license": "Apache-2.0",
  "server": {
    "type": "binary",
    "entry_point": "bin/nonprofit-explorer-pp-mcp",
    "mcp_config": {
      "command": "${__dirname}/bin/nonprofit-explorer-pp-mcp",
      "args": []
    }
  },
  "compatibility": {
    "claude_desktop": ">=1.0.0",
    "platforms": [
      "darwin",
      "linux",
      "win32"
    ]
  }
}
