{
  "manifest_version": "0.3",
  "name": "epropertyplus-pp-mcp",
  "display_name": "ePropertyPlus",
  "version": "4.15.0",
  "description": "Every land bank's public inventory, one command — enumerate, filter, export, and image any ePropertyPlus instance by slug.",
  "author": {
    "name": "CLI Printing Press"
  },
  "license": "Apache-2.0",
  "server": {
    "type": "binary",
    "entry_point": "bin/epropertyplus-pp-mcp",
    "mcp_config": {
      "command": "${__dirname}/bin/epropertyplus-pp-mcp",
      "args": []
    }
  },
  "compatibility": {
    "claude_desktop": ">=1.0.0",
    "platforms": [
      "darwin",
      "linux",
      "win32"
    ]
  }
}
