{
  "manifest_version": "0.3",
  "name": "redfin-pp-cli",
  "display_name": "Redfin",
  "version": "4.5.2",
  "description": "Every Redfin property, market stat, and price history \u2014 synced locally, queryable offline, and built for agents.",
  "author": {
    "name": "CLI Printing Press"
  },
  "license": "Apache-2.0",
  "server": {
    "type": "binary",
    "entry_point": "bin/redfin-pp-mcp",
    "mcp_config": {
      "command": "${__dirname}/bin/redfin-pp-mcp",
      "args": []
    }
  },
  "compatibility": {
    "claude_desktop": ">=1.0.0",
    "platforms": [
      "darwin",
      "linux",
      "win32"
    ]
  },
  "printer": "das8terman",
  "printer_name": "user"
}