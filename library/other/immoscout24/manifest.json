{
  "manifest_version": "0.3",
  "name": "immoscout24-pp-mcp",
  "display_name": "ImmoScout24",
  "version": "0.1.0",
  "description": "Search ImmoScout24 through the replayable mobile JSON API, not brittle blocked HTML.",
  "author": {
    "name": "CLI Printing Press"
  },
  "license": "Apache-2.0",
  "server": {
    "type": "binary",
    "entry_point": "bin/immoscout24-pp-mcp",
    "mcp_config": {
      "command": "${__dirname}/bin/immoscout24-pp-mcp",
      "args": []
    }
  },
  "compatibility": {
    "claude_desktop": ">=1.0.0",
    "platforms": [
      "darwin",
      "linux",
      "win32"
    ]
  }
}
