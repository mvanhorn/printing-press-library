{
  "manifest_version": "0.3",
  "name": "squire-pp-mcp",
  "display_name": "Squire",
  "version": "0.0.0",
  "description": "Every barbershop on Squire, queryable from the terminal — cross-shop price compare, soonest-available barber, and review rankings the website never built.",
  "author": {
    "name": "CLI Printing Press"
  },
  "license": "Apache-2.0",
  "server": {
    "type": "binary",
    "entry_point": "bin/squire-pp-mcp",
    "mcp_config": {
      "command": "${__dirname}/bin/squire-pp-mcp",
      "args": []
    }
  },
  "compatibility": {
    "claude_desktop": ">=1.0.0",
    "platforms": [
      "darwin",
      "linux",
      "win32"
    ]
  }
}
