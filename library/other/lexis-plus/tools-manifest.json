{
  "api_name": "lexis-plus",
  "base_url": "https://plus.lexis.com",
  "description": "Pull California cases and annotated statutes from your own Lexis+ subscription straight into Word, by citation.",
  "mcp_ready": "partial",
  "http_transport": "standard",
  "auth": {
    "type": "cookie",
    "in": "cookie",
    "cookie_domain": "plus.lexis.com",
    "cookies": [
      ".AspNet.Wam",
      "ASP.NET_SessionId",
      "LexisMachineId",
      "X-LN-InitialSignOn",
      "X-LN-Session-TTL",
      "lna2"
    ]
  },
  "required_headers": [
    {
      "name": "Accept-Language",
      "value": "en-US,en;q=0.9"
    }
  ],
  "tools": []
}
