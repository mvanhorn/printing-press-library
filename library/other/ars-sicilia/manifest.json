{
  "manifest_version": "0.3",
  "name": "ars-sicilia-pp-mcp",
  "display_name": "Ars Sicilia",
  "version": "4.18.0",
  "description": "Gli archivi dell'Assemblea Regionale Siciliana come tool MCP: disegni di legge, leggi, interrogazioni, mozioni, resoconti d'aula e lavori delle commissioni.",
  "author": {
    "name": "CLI Printing Press"
  },
  "license": "Apache-2.0",
  "server": {
    "type": "binary",
    "entry_point": "bin/ars-sicilia-pp-mcp",
    "mcp_config": {
      "command": "${__dirname}/bin/ars-sicilia-pp-mcp",
      "args": []
    }
  },
  "compatibility": {
    "claude_desktop": ">=1.0.0",
    "platforms": [
      "darwin",
      "linux",
      "win32"
    ]
  }
}
