<!DOCTYPE html><html data-dpl-id="dpl_FgG1pj8DLS6CsFkWisFsxTeECfyH" lang="en" class="geist_a71539c9-module__T19VSG__variable geist_mono_8d43a2aa-module__8Li5zG__variable geist_pixel_a950c77b-module__CJvUPq__variable h-full antialiased light"><head><meta charSet="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><link rel="stylesheet" href="/_next/static/immutable/chunks/2m5bdkfc8ee9m.css" data-precedence="next"/><link rel="preload" as="script" fetchPriority="low" href="/_next/static/immutable/chunks/2br1o3y1th5s4.js"/><script src="/_next/static/immutable/chunks/39gu4r-n8kp75.js" async=""></script><script src="/_next/static/immutable/chunks/3f8_4v7jwvgwo.js" async=""></script><script src="/_next/static/immutable/chunks/0errv6nsxtwow.js" async=""></script><script src="/_next/static/immutable/chunks/turbopack-3coyhtmcfal6b.js" async=""></script><script src="/_next/static/immutable/chunks/21v0dslobqgrc.js" async="" crossorigin=""></script><script src="/_next/static/immutable/chunks/2rkqd12-gfl8b.js" async="" crossorigin=""></script><script src="/_next/static/immutable/chunks/1kylzt-65vf5g.js" async="" crossorigin=""></script><script src="/_next/static/immutable/chunks/38qu2f98a5xkz.js" async="" crossorigin=""></script><script src="/_next/static/immutable/chunks/3rtodhu9_8on2.js" async="" crossorigin=""></script><meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)"/><meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)"/><meta name="color-scheme" content="light dark"/><meta name="next-size-adjust" content=""/><title>Is Agentic developer docs: API, CLI, and MCP</title><meta name="description" content="Official Is Agentic developer documentation for the versioned API, OpenAPI contract, CLI, structured errors, rate limits, and MCP server."/><meta name="application-name" content="Is Agentic"/><link rel="author" href="https://vercel.com"/><meta name="author" content="Vercel"/><link rel="manifest" href="/manifest.webmanifest"/><meta name="keywords" content="AI agents,agent readiness,website score,AI accessibility,llms.txt"/><meta name="referrer" content="strict-origin-when-cross-origin"/><meta name="creator" content="Ora + Vercel"/><meta name="publisher" content="Vercel"/><meta name="robots" content="index, follow"/><meta name="googlebot" content="index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1"/><meta name="category" content="technology"/><link rel="canonical" href="https://is-agentic.com/docs"/><meta property="og:title" content="Is Agentic developer docs: API, CLI, and MCP"/><meta property="og:description" content="Official Is Agentic developer documentation for the versioned API, OpenAPI contract, CLI, structured errors, rate limits, and MCP server."/><meta property="og:url" content="https://is-agentic.com/docs"/><meta property="og:site_name" content="Is Agentic"/><meta property="og:locale" content="en_US"/><meta property="og:image" content="https://is-agentic.com/opengraph-image?v=2"/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta property="og:image:alt" content="Is Agentic — score how ready a site is for agents"/><meta property="og:type" content="website"/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content="Is Agentic developer docs: API, CLI, and MCP"/><meta name="twitter:description" content="Official Is Agentic developer documentation for the versioned API, OpenAPI contract, CLI, structured errors, rate limits, and MCP server."/><meta name="twitter:image" content="https://is-agentic.com/opengraph-image?v=2"/><link rel="icon" href="/favicon.ico?favicon.3fpu2ql9ns1a0.ico" sizes="256x256" type="image/x-icon"/><script>var storedTheme=null;try{storedTheme=localStorage.getItem("is-agentic-theme")||localStorage.getItem("agent-rubric-theme")}catch(e){}var systemDark=window.matchMedia&&window.matchMedia("(prefers-color-scheme: dark)").matches;var theme=storedTheme==="dark"||(storedTheme!=="light"&&systemDark)?"dark":"light";document.documentElement.classList.remove("light","dark");document.documentElement.classList.add(theme);</script><script src="/_next/static/immutable/chunks/0c0hxoamwjsbw.js" noModule=""></script></head><body class="m-0 min-h-full bg-white font-sans text-base font-normal text-neutral-900 dark:bg-black dark:text-neutral-100"><div hidden=""><!--$--><!--/$--></div><script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"Organization","@id":"https://is-agentic.com/#organization","name":"Vercel Inc.","url":"https://vercel.com","sameAs":["https://github.com/vercel-labs/is-agentic","https://www.npmjs.com/package/is-agentic"],"email":"[redacted-email]","contactPoint":{"@type":"ContactPoint","contactType":"security and product support","email":"[redacted-email]","url":"https://is-agentic.com/contact","availableLanguage":"English"},"address":{"@type":"PostalAddress","streetAddress":"440 N Barranca Avenue #4133","addressLocality":"Covina","addressRegion":"CA","postalCode":"91723","addressCountry":"US"}},{"@type":"WebSite","@id":"https://is-agentic.com/#website","name":"Is Agentic","alternateName":"Is Agentic by Vercel","url":"https://is-agentic.com/","description":"Score how ready a website is for AI agents, then get evidence and recommendations to improve it.","publisher":{"@id":"https://is-agentic.com/#organization"},"sameAs":["https://github.com/vercel-labs/is-agentic","https://www.npmjs.com/package/is-agentic"]},{"@type":"WebApplication","@id":"https://is-agentic.com/#application","name":"Is Agentic","alternateName":"Is Agentic by Vercel","url":"https://is-agentic.com/","description":"Score how ready a website is for AI agents, then get evidence and recommendations to improve it.","applicationCategory":"DeveloperApplication","operatingSystem":"Any","provider":{"@id":"https://is-agentic.com/#organization"},"isPartOf":{"@id":"https://is-agentic.com/#website"},"softwareHelp":"https://is-agentic.com/docs","sameAs":["https://github.com/vercel-labs/is-agentic","https://www.npmjs.com/package/is-agentic"]}]}</script><!--&--><!--&--><div class="min-h-screen"><div class="mx-auto flex min-h-screen w-full max-w-7xl flex-col px-4 pt-6 lg:px-10"><a class="fixed top-3 left-3 z-50 -translate-y-20 rounded-md bg-neutral-900 px-3 py-2 text-sm font-medium text-white transition-transform focus-visible:translate-y-0 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 dark:bg-neutral-100 dark:text-black dark:focus-visible:outline-blue-400" href="#main">Skip to content</a><header class="relative z-10 m-0 p-0"><div class="flex min-h-9 items-center justify-between gap-2 sm:gap-4"><div class="flex min-w-0 items-center gap-2 overflow-hidden"><a aria-label="Vercel" class="inline-flex shrink-0 text-inherit no-underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 dark:focus-visible:outline-blue-400" title="Made with love by Vercel" href="https://vercel.com"><svg aria-hidden="true" height="18" viewBox="0 0 16 16" width="18"><path d="M8 1L16 15H0L8 1Z" fill="currentColor"></path></svg></a><span aria-hidden="true" class="shrink-0 text-neutral-400 dark:text-neutral-600"><svg height="16" viewBox="0 0 16 16" width="16"><path d="M4.01526 15.3939L4.3107 14.7046L10.3107 0.704556L10.6061 0.0151978L11.9849 0.606077L11.6894 1.29544L5.68942 15.2954L5.39398 15.9848L4.01526 15.3939Z" fill="currentColor"></path></svg></span><a aria-label="Is Agentic home" class="truncate font-pixel text-lg font-medium tracking-tight text-inherit no-underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 dark:focus-visible:outline-blue-400" href="/">Is Agentic</a></div><button aria-label="Copy command: npx is-agentic" class="group ml-auto hidden h-9 shrink-0 cursor-pointer items-center gap-2.5 rounded-full border border-neutral-200 bg-white px-3 text-left transition-colors hover:border-neutral-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 sm:flex dark:border-neutral-800 dark:bg-neutral-950 dark:hover:border-neutral-600 dark:hover:bg-neutral-900 dark:focus-visible:outline-blue-400" type="button"><code class="font-mono text-[13px] text-neutral-800 dark:text-neutral-200"><span aria-hidden="true" class="text-neutral-400 dark:text-neutral-600">$<!-- --> </span>npx is-agentic<!-- --> <span class="text-neutral-500 dark:text-neutral-400">[domain]</span></code><span aria-hidden="true" class="shrink-0 text-neutral-400 transition-colors group-hover:text-neutral-700 dark:text-neutral-600 dark:group-hover:text-neutral-300"><svg fill="none" height="16" viewBox="0 0 18 18" width="16"><rect height="9.5" rx="1.5" stroke="currentColor" stroke-width="1.5" width="9.5" x="6" y="6"></rect><path d="M12 6V4a1.5 1.5 0 0 0-1.5-1.5h-6A1.5 1.5 0 0 0 3 4v6A1.5 1.5 0 0 0 4.5 11H6" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path></svg></span><span aria-live="polite" class="sr-only"></span></button></div></header><main id="main" class="flex-1 py-16"><article class="grid max-w-3xl gap-12"><header class="grid gap-4"><h1 class="m-0 text-balance text-4xl leading-tight font-medium tracking-tighter">Is Agentic developer docs</h1><p class="m-0 max-w-2xl text-pretty text-lg text-neutral-600 dark:text-neutral-400">Official Is Agentic developer documentation for the versioned API, OpenAPI contract, CLI, structured errors, rate limits, and MCP server.</p></header><div class="grid gap-10 leading-7"><script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"TechArticle","@id":"https://is-agentic.com/docs","url":"https://is-agentic.com/docs","name":"Is Agentic developer docs: API, CLI, and MCP","headline":"Is Agentic developer docs: API, CLI, and MCP","description":"Official Is Agentic developer documentation for the versioned API, OpenAPI contract, CLI, structured errors, rate limits, and MCP server.","inLanguage":"en","about":{"@id":"https://is-agentic.com/#application"},"isPartOf":{"@id":"https://is-agentic.com/#website"},"author":{"@type":"Organization","@id":"https://is-agentic.com/#organization","name":"Vercel Inc."},"publisher":{"@id":"https://is-agentic.com/#organization"},"breadcrumb":{"@id":"https://is-agentic.com/docs#breadcrumb"}},{"@type":"BreadcrumbList","@id":"https://is-agentic.com/docs#breadcrumb","itemListElement":[{"@type":"ListItem","position":1,"name":"Is Agentic","item":"https://is-agentic.com/"},{"@type":"ListItem","position":2,"name":"Developer docs"}]}]}</script><section class="grid scroll-mt-8 gap-3"><h2 class="m-0 text-2xl font-medium tracking-tight">Overview</h2><div class="grid gap-3 text-neutral-700 dark:text-neutral-300"><p class="m-0">Is Agentic has three integration surfaces, all public, read-only, and free: the<!-- --> <a class="text-inherit underline decoration-neutral-400 underline-offset-4 hover:decoration-neutral-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 dark:decoration-neutral-600 dark:hover:decoration-neutral-100 dark:focus-visible:outline-blue-400" href="#api">report API</a> <!-- -->returns the latest completed report as JSON, the<!-- --> <a class="text-inherit underline decoration-neutral-400 underline-offset-4 hover:decoration-neutral-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 dark:decoration-neutral-600 dark:hover:decoration-neutral-100 dark:focus-visible:outline-blue-400" href="#cli">CLI</a> <!-- -->renders the same report in a terminal, and the<!-- --> <a class="text-inherit underline decoration-neutral-400 underline-offset-4 hover:decoration-neutral-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 dark:decoration-neutral-600 dark:hover:decoration-neutral-100 dark:focus-visible:outline-blue-400" href="#mcp">MCP server</a> <!-- -->exposes it as tools for agent hosts. Reports are created on the<!-- --> <a class="text-inherit underline decoration-neutral-400 underline-offset-4 hover:decoration-neutral-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 dark:decoration-neutral-600 dark:hover:decoration-neutral-100 dark:focus-visible:outline-blue-400" href="/">home page</a> <!-- -->or by the CLI when none exists; every surface here reads completed reports.</p></div></section><section id="api" class="grid scroll-mt-8 gap-3"><h2 class="m-0 text-2xl font-medium tracking-tight">Public report API</h2><div class="grid gap-3 text-neutral-700 dark:text-neutral-300"><p class="m-0">Retrieve the latest completed Is Agentic report for a public URL. The response includes the score, Essential and Recommended buckets, bonus signals, evidence-backed issues, and the canonical browser report. This read-only endpoint does not launch a scan.</p><pre class="overflow-x-auto rounded-xl border border-neutral-200 bg-neutral-50 p-4 font-mono text-sm dark:border-neutral-800 dark:bg-neutral-950"><code>curl &quot;https://is-agentic.com/api/v1/report?url=https%3A%2F%2Fexample.com&quot;</code></pre><p class="m-0">Read the complete request and response schema in the<!-- --> <a class="text-inherit underline decoration-neutral-400 underline-offset-4 hover:decoration-neutral-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 dark:decoration-neutral-600 dark:hover:decoration-neutral-100 dark:focus-visible:outline-blue-400" href="/openapi.json">Is Agentic OpenAPI description</a>. Discover the API portfolio through the<!-- --> <a class="text-inherit underline decoration-neutral-400 underline-offset-4 hover:decoration-neutral-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 dark:decoration-neutral-600 dark:hover:decoration-neutral-100 dark:focus-visible:outline-blue-400" href="/.well-known/api-catalog">RFC 9727 API catalog</a>.</p></div></section><section id="errors" class="grid scroll-mt-8 gap-3"><h2 class="m-0 text-2xl font-medium tracking-tight">Structured errors</h2><div class="grid gap-3 text-neutral-700 dark:text-neutral-300"><p class="m-0">Every documented report API error and every scan failure returned before streaming uses RFC 9457 problem details with<code> application/problem+json</code>. Responses include a stable<code> code</code>, human-readable <code>detail</code>, and a concrete<code>resolution</code> hint. Unknown API routes and methods return the same shape instead of an HTML error page.</p><dl class="m-0 grid gap-3"><div id="invalid-url"><dt class="font-medium"><code>invalid_url</code> · 400</dt><dd class="m-0">Pass a public HTTP or HTTPS URL.</dd></div><div id="report-not-found"><dt class="font-medium"><code>report_not_found</code> · 404</dt><dd class="m-0">Run the linked scan, then retry after completion.</dd></div><div id="method-not-allowed"><dt class="font-medium"><code>method_not_allowed</code> · 405</dt><dd class="m-0">Use the documented read-only GET operation.</dd></div><div id="rate-limit-exceeded"><dt class="font-medium"><code>rate_limit_exceeded</code> · 429</dt><dd class="m-0">Honor <code>Retry-After</code> before retrying.</dd></div><div id="report-temporarily-unavailable"><dt class="font-medium"><code>report_temporarily_unavailable</code> · 503</dt><dd class="m-0">Retry shortly without launching a new scan.</dd></div><div id="api-route-not-found"><dt class="font-medium"><code>api_route_not_found</code> · 404</dt><dd class="m-0">Use OpenAPI or the API catalog to recover.</dd></div></dl></div></section><section id="rate-limits" class="grid scroll-mt-8 gap-3"><h2 class="m-0 text-2xl font-medium tracking-tight">Rate limits</h2><div class="grid gap-3 text-neutral-700 dark:text-neutral-300"><p class="m-0">The report API allows 120 requests per client IP in each 60-second window. Responses advertise the policy and current quota through the current IETF <code>RateLimit-Policy</code> and <code>RateLimit</code>structured fields, with compatibility fields for older clients. A 429 response also includes <code>Retry-After</code>.</p></div></section><section id="versioning-and-deprecation" class="grid scroll-mt-8 gap-3"><h2 class="m-0 text-2xl font-medium tracking-tight">Versioning and deprecation</h2><div class="grid gap-3 text-neutral-700 dark:text-neutral-300"><p class="m-0">Stable REST operations use a major version in the URL, beginning with<code> /api/v1</code>. Backward-compatible fields may be added within v1; breaking request or response changes require a new major path. Before removing a stable version, Is Agentic will publish a migration guide and signal deprecation with RFC 9745 <code>Deprecation</code>and <code>Link</code> headers. A dated <code>Sunset</code> header will be announced at least 90 days before removal.</p><p class="m-0">The unversioned <code>/api/report</code> route remains available as a deprecated compatibility alias. No sunset is currently scheduled; new integrations should use <code>/api/v1/report</code>.</p></div></section><section id="authentication-and-write-operations" class="grid scroll-mt-8 gap-3"><h2 class="m-0 text-2xl font-medium tracking-tight">Authentication, webhooks, and writes</h2><div class="grid gap-3 text-neutral-700 dark:text-neutral-300"><p class="m-0">The documented JSON API and MCP tool are public and read-only. They require no API key or OAuth flow, expose no credentials, and do not provide writes, webhooks, or event subscriptions. Start a new scan on the <a class="text-inherit underline decoration-neutral-400 underline-offset-4 hover:decoration-neutral-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 dark:decoration-neutral-600 dark:hover:decoration-neutral-100 dark:focus-visible:outline-blue-400" href="/">Is Agentic home page</a>, then use these interfaces after the report completes.</p><p class="m-0">Because the API exposes one read-only resource and no collection, write, or long-running operation, pagination, Idempotency-Key, and asynchronous-job conventions do not apply. The OpenAPI description is the supported language-neutral integration contract; the official CLI is the maintained command-line client.</p></div></section><section id="cli" class="grid scroll-mt-8 gap-3"><h2 class="m-0 text-2xl font-medium tracking-tight">CLI</h2><div class="grid gap-3 text-neutral-700 dark:text-neutral-300"><p class="m-0">Retrieve the latest completed report from a terminal with the<!-- --> <a class="text-inherit underline decoration-neutral-400 underline-offset-4 hover:decoration-neutral-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 dark:decoration-neutral-600 dark:hover:decoration-neutral-100 dark:focus-visible:outline-blue-400" href="https://www.npmjs.com/package/is-agentic">official is-agentic package on npm</a>. The command calls the same read-only public API, renders a compact terminal score with every failed or partial finding, and returns a stored report immediately. When no completed report exists, it starts a scan and waits for the stored result. Add <code>--json</code> for the unchanged API response and structured error objects suitable for agents and scripts.</p><pre class="overflow-x-auto rounded-xl border border-neutral-200 bg-neutral-50 p-4 font-mono text-sm dark:border-neutral-800 dark:bg-neutral-950"><code>npx is-agentic &lt;domain&gt;
npx is-agentic &lt;domain&gt; --json</code></pre></div></section><section id="mcp" class="grid scroll-mt-8 gap-3"><h2 class="m-0 text-2xl font-medium tracking-tight">MCP server</h2><div class="grid gap-3 text-neutral-700 dark:text-neutral-300"><p class="m-0">Connect a Streamable HTTP MCP client to the endpoint below. The server exposes three read-only tools: <code>is_agentic_get_report</code> for completed reports, <code>is_agentic_get_methodology</code> for score interpretation, and <code>is_agentic_get_developer_docs</code> for integration guidance. Each returns text plus structured data.</p><pre class="overflow-x-auto rounded-xl border border-neutral-200 bg-neutral-50 p-4 font-mono text-sm dark:border-neutral-800 dark:bg-neutral-950"><code>https://is-agentic.com/mcp</code></pre><p class="m-0">Discovery documents, none requiring authentication, each declaring the Streamable HTTP endpoint:</p><ul class="m-0 grid list-disc gap-2 pl-5"><li><a class="text-inherit underline decoration-neutral-400 underline-offset-4 hover:decoration-neutral-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 dark:decoration-neutral-600 dark:hover:decoration-neutral-100 dark:focus-visible:outline-blue-400" href="/server.json">MCP Registry manifest</a> <!-- -->for registries and clients discovering the remote transport</li><li><a class="text-inherit underline decoration-neutral-400 underline-offset-4 hover:decoration-neutral-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 dark:decoration-neutral-600 dark:hover:decoration-neutral-100 dark:focus-visible:outline-blue-400" href="/mcp/server-card">Server card</a>, also served at its<!-- --> <a class="text-inherit underline decoration-neutral-400 underline-offset-4 hover:decoration-neutral-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 dark:decoration-neutral-600 dark:hover:decoration-neutral-100 dark:focus-visible:outline-blue-400" href="/.well-known/mcp/server-card.json">well-known compatibility URL</a></li><li><a class="text-inherit underline decoration-neutral-400 underline-offset-4 hover:decoration-neutral-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 dark:decoration-neutral-600 dark:hover:decoration-neutral-100 dark:focus-visible:outline-blue-400" href="/.well-known/ai-catalog.json">AI Catalog</a> <!-- -->as the domain-level discovery entry point</li></ul><p class="m-0">The report tool links to an interactive score card through the MCP Apps<code> ui://is-agentic/score-report.html</code> resource. Hosts that support MCP Apps can render the report directly in conversation; every other host still receives the same text and structured result.</p></div></section><section id="skill" class="grid scroll-mt-8 gap-3"><h2 class="m-0 text-2xl font-medium tracking-tight">Agent skill</h2><div class="grid gap-3 text-neutral-700 dark:text-neutral-300"><p class="m-0">The<!-- --> <a class="text-inherit underline decoration-neutral-400 underline-offset-4 hover:decoration-neutral-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 dark:decoration-neutral-600 dark:hover:decoration-neutral-100 dark:focus-visible:outline-blue-400" href="https://github.com/vercel-labs/is-agentic/tree/main/skills/is-agentic">official Is Agentic agent skill</a> <!-- -->packages this integration guidance for agents: how to get a score, read a report, work through issues by tier, and handle every documented error.</p><pre class="overflow-x-auto rounded-xl border border-neutral-200 bg-neutral-50 p-4 font-mono text-sm dark:border-neutral-800 dark:bg-neutral-950"><code>npx skills add vercel-labs/is-agentic</code></pre><p class="m-0">Agents can also discover the skill through the<!-- --> <a class="text-inherit underline decoration-neutral-400 underline-offset-4 hover:decoration-neutral-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 dark:decoration-neutral-600 dark:hover:decoration-neutral-100 dark:focus-visible:outline-blue-400" href="/.well-known/agent-skills/index.json">well-known agent-skills index</a>, which lists the skill file with its SHA-256 digest.</p></div></section><section class="grid scroll-mt-8 gap-3"><h2 class="m-0 text-2xl font-medium tracking-tight">Markdown content negotiation</h2><div class="grid gap-3 text-neutral-700 dark:text-neutral-300"><p class="m-0">Public content pages and completed scan reports support canonical<code> Accept: text/markdown</code> negotiation. Markdown variants set<code> Content-Type: text/markdown; charset=utf-8</code> and include<code> Accept</code> in the <code>Vary</code> response header so shared caches never mix representations.</p><pre class="overflow-x-auto rounded-xl border border-neutral-200 bg-neutral-50 p-4 font-mono text-sm dark:border-neutral-800 dark:bg-neutral-950"><code>curl -H &quot;Accept: text/markdown&quot; https://is-agentic.com/methodology</code></pre></div></section><section id="pricing" class="grid scroll-mt-8 gap-3"><h2 class="m-0 text-2xl font-medium tracking-tight">Pricing</h2><div class="grid gap-3 text-neutral-700 dark:text-neutral-300"><p class="m-0">Is Agentic is currently free to use. There are no paid plans, subscription charges, or per-report fees. The public website, read-only API, official CLI, and MCP server are available without payment. Read the concise, machine-readable<!-- --> <a class="text-inherit underline decoration-neutral-400 underline-offset-4 hover:decoration-neutral-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 dark:decoration-neutral-600 dark:hover:decoration-neutral-100 dark:focus-visible:outline-blue-400" href="/pricing.md">Is Agentic pricing statement</a>.</p></div></section></div></article></main><footer class="border-t border-neutral-200 py-8 text-sm text-neutral-600 dark:border-neutral-800 dark:text-neutral-400"><div class="grid grid-cols-[minmax(0,1fr)_auto] items-end gap-x-6 gap-y-7 lg:flex lg:items-center lg:gap-6"><p class="col-start-1 row-start-2 m-0 flex min-w-0 flex-wrap gap-x-1.5 leading-6 lg:order-1 lg:mr-auto"><span class="whitespace-nowrap">© <!-- -->2026<!-- --> Vercel.</span><span class="whitespace-nowrap">Powered by<!-- --> <a class="text-inherit underline underline-offset-4 hover:text-neutral-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 dark:hover:text-neutral-100 dark:focus-visible:outline-blue-400" href="https://ora.ai" rel="noreferrer" target="_blank">Ora</a>.</span></p><nav aria-label="Footer" class="col-span-2 row-start-1 grid grid-cols-2 gap-x-8 gap-y-3 text-base sm:grid-cols-3 lg:order-2 lg:flex lg:items-center lg:gap-5 lg:text-sm"><a class="w-fit text-inherit underline-offset-4 hover:text-neutral-900 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 dark:hover:text-neutral-100 dark:focus-visible:outline-blue-400" href="/about">About</a><a class="w-fit text-inherit underline-offset-4 hover:text-neutral-900 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 dark:hover:text-neutral-100 dark:focus-visible:outline-blue-400" href="/methodology">Methodology</a><a class="w-fit text-inherit underline-offset-4 hover:text-neutral-900 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 dark:hover:text-neutral-100 dark:focus-visible:outline-blue-400" href="/docs">Docs</a><a class="w-fit text-inherit underline-offset-4 hover:text-neutral-900 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 dark:hover:text-neutral-100 dark:focus-visible:outline-blue-400" rel="privacy-policy" href="/privacy">Privacy</a><a class="w-fit text-inherit underline-offset-4 hover:text-neutral-900 hover:underline focus-visible:outline-2 focus-visible:outl