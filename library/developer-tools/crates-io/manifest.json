{
  "manifest_version": "0.3",
  "name": "crates-io-pp-mcp",
  "display_name": "Crates Io Registry",
  "version": "0.0.0",
  "description": "Read-only endpoints for crates.io ecosystem intelligence.",
  "author": {
    "name": "CLI Printing Press"
  },
  "license": "Apache-2.0",
  "server": {
    "type": "binary",
    "entry_point": "bin/crates-io-pp-mcp",
    "mcp_config": {
      "command": "${__dirname}/bin/crates-io-pp-mcp",
      "args": []
    }
  },
  "compatibility": {
    "claude_desktop": ">=1.0.0",
    "platforms": [
      "darwin",
      "linux",
      "win32"
    ]
  }
}
