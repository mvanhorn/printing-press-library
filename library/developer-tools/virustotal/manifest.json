{
  "manifest_version": "0.3",
  "name": "virustotal-pp-mcp",
  "display_name": "Virustotal",
  "version": "4.2.2",
  "description": "Virustotal API surface as MCP tools.",
  "author": {
    "name": "CLI Printing Press"
  },
  "license": "Apache-2.0",
  "server": {
    "type": "binary",
    "entry_point": "bin/virustotal-pp-mcp",
    "mcp_config": {
      "command": "${__dirname}/bin/virustotal-pp-mcp",
      "args": [],
      "env": {
        "VIRUSTOTAL_API_KEY": "${user_config.virustotal_api_key}"
      }
    }
  },
  "user_config": {
    "virustotal_api_key": {
      "type": "string",
      "title": "VIRUSTOTAL_API_KEY",
      "description": "Sets VIRUSTOTAL_API_KEY for the Virustotal MCP server.",
      "sensitive": true,
      "required": true
    }
  },
  "compatibility": {
    "claude_desktop": ">=1.0.0",
    "platforms": [
      "darwin",
      "linux",
      "win32"
    ]
  }
}
