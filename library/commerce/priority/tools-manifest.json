    },
    {
      "name": "orders_list",
      "description": "List sales orders. Optional: filter, odata-select, orderby (plus 4 more). Returns array of Order.",
      "method": "GET",
      "path": "/ORDERS",
      "params": [
        {
          "name": "filter",
          "wire_name": "$filter",
          "type": "string",
          "location": "query",
          "description": "OData $filter, e.g. 'ORDSTATUSDES eq 'Confirmed''"
        },
        {
          "name": "odata-select",
          "wire_name": "$select",
          "type": "string",
          "location": "query",
          "description": "Server-side projection"
        },
        {
          "name": "orderby",
          "wire_name": "$orderby",
          "type": "string",
          "location": "query",
          "description": "Sort, e.g. 'CURDATE desc'"
        },
        {
          "name": "top",
          "wire_name": "$top",
          "type": "int",
          "location": "query",
          "description": "Max rows"
        },
        {
          "name": "skip",
          "wire_name": "$skip",
          "type": "int",
          "location": "query",
          "description": "Rows to skip"
        },
        {
          "name": "expand",
          "wire_name": "$expand",
          "type": "string",
          "location": "query",
          "description": "Subforms to expand, e.g. ORDERITEMS_SUBFORM"
        },
        {
          "name": "since",
          "wire_name": "$since",
          "type": "string",
          "location": "query",
          "description": "Changed since UTC time (ORDERS is BPM-enabled)"
        }
      ]
    },
    {
      "name": "parts_get",
      "description": "Get one part by part number. Required: partname. Optional: expand. Returns the Part.",
      "method": "GET",
      "path": "/LOGPART('{partname}')",
      "params": [
        {
          "name": "partname",
          "type": "string",
