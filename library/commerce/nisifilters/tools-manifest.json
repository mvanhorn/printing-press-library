{
  "api_name": "nisifilters",
  "base_url": "https://nisifilters.it/wp-json/wp/v2",
  "description": "A read-only, offline-first mirror and search engine for the public NiSi Italia filter catalog and content.",
  "mcp_ready": "full",
  "http_transport": "standard",
  "auth": {
    "type": "none"
  },
  "required_headers": [],
  "tools": [
    {
      "name": "authors_get",
      "description": "Get a single author by numeric ID. Required: id. Returns the Author.",
      "method": "GET",
      "path": "/users/{id}",
      "no_auth": true,
      "params": [
        {
          "name": "id",
          "type": "int",
          "location": "path",
          "description": "Author (user) ID",
          "required": true
        }
      ]
    },
    {
      "name": "authors_list",
      "description": "List public authors. Optional: page (default: 1), per_page (default: 20), search. Returns array of Author.",
      "method": "GET",
      "path": "/users",
      "no_auth": true,
      "params": [
        {
          "name": "page",
          "type": "int",
          "location": "query",
          "description": "Page of results"
        },
        {
          "name": "per_page",
          "type": "int",
          "location": "query",
          "description": "Results per page (max 100)"
        },
        {
          "name": "search",
          "type": "string",
          "location": "query",
          "description": "Search authors by name"
        }
      ]
    },
    {
      "name": "categories_get",
      "description": "Get a single category by numeric ID. Required: id. Returns the Term.",
      "method": "GET",
      "path": "/categories/{id}",
      "no_auth": true,
      "params": [
        {
          "name": "id",
          "type": "int",
          "location": "path",
          "description": "Category ID",
          "required": true
        }
      ]
    },
    {
      "name": "categories_list",
      "description": "List post categories. Optional: page (default: 1), per_page (default: 100), search. Returns array of Term.",
      "method": "GET",
      "path": "/categories",
      "no_auth": true,
      "params": [
        {
          "name": "page",
          "type": "int",
          "location": "query",
          "description": "Page of results"
        },
        {
          "name": "per_page",
          "type": "int",
          "location": "query",
          "description": "Results per page (max 100)"
        },
        {
          "name": "search",
          "type": "string",
          "location": "query",
          "description": "Search categories by name"
        }
      ]
    },
    {
      "name": "comments_get",
      "description": "Get a single comment by numeric ID. Required: id. Returns the Comment.",
      "method": "GET",
      "path": "/comments/{id}",
      "no_auth": true,
      "params": [
        {
          "name": "id",
          "type": "int",
          "location": "path",
          "description": "Comment ID",
          "required": true
        }
      ]
