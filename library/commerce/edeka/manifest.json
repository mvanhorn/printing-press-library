{
  "manifest_version": "0.3",
  "name": "edeka-pp-mcp",
  "display_name": "EDEKA",
  "version": "0.1.0",
  "description": "Shop your local EDEKA market from the terminal or an agent: offers, basket by text, earliest pickup slot, checkout with a confirmation gate.",
  "author": {
    "name": "CLI Printing Press"
  },
  "license": "Apache-2.0",
  "server": {
    "type": "binary",
    "entry_point": "bin/edeka-pp-mcp",
    "mcp_config": {
      "command": "${__dirname}/bin/edeka-pp-mcp",
      "args": []
    }
  },
  "compatibility": {
    "claude_desktop": ">=1.0.0",
    "platforms": [
      "darwin",
      "linux",
      "win32"
    ]
  }
}
