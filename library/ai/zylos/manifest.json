{
  "manifest_version": "0.3",
  "name": "zylos-pp-mcp",
  "display_name": "Zylos",
  "version": "4.2.0",
  "description": "Zylos API surface as MCP tools.",
  "author": {
    "name": "CLI Printing Press"
  },
  "license": "Apache-2.0",
  "server": {
    "type": "binary",
    "entry_point": "bin/zylos-pp-mcp",
    "mcp_config": {
      "command": "${__dirname}/bin/zylos-pp-mcp",
      "args": [],
      "env": {
        "ZYLOS_PASSWORD": "${user_config.zylos_password}"
      }
    }
  },
  "user_config": {
    "zylos_password": {
      "type": "string",
      "title": "ZYLOS_PASSWORD",
      "description": "Password-based session authentication. Login via POST /api/auth to receive a session cookie.",
      "sensitive": true
    }
  },
  "compatibility": {
    "claude_desktop": ">=1.0.0",
    "platforms": [
      "darwin",
      "linux",
      "win32"
    ]
  }
}
