{
  "manifest_version": "0.3",
  "name": "valyu-pp-mcp",
  "display_name": "Valyu",
  "version": "0.0.0",
  "description": "The search API built for AI agents.",
  "author": {
    "name": "CLI Printing Press"
  },
  "license": "Apache-2.0",
  "server": {
    "type": "binary",
    "entry_point": "bin/valyu-pp-mcp",
    "mcp_config": {
      "command": "${__dirname}/bin/valyu-pp-mcp",
      "args": [],
      "env": {
        "VALYU_API_KEY": "${user_config.valyu_api_key}"
      }
    }
  },
  "user_config": {
    "valyu_api_key": {
      "type": "string",
      "title": "VALYU_API_KEY",
      "description": "Sets VALYU_API_KEY for the Valyu MCP server. Get a credential from https://platform.valyu.ai.",
      "sensitive": true,
      "required": true
    }
  },
  "compatibility": {
    "claude_desktop": ">=1.0.0",
    "platforms": [
      "darwin",
      "linux",
      "win32"
    ]
  }
}
