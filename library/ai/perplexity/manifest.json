{
  "manifest_version": "0.3",
  "name": "perplexity-pp-mcp",
  "display_name": "Perplexity",
  "version": "0.0.0",
  "description": "Export Perplexity research traces and browse recent threads from a logged-in browser session.",
  "author": {
    "name": "CLI Printing Press"
  },
  "license": "Apache-2.0",
  "server": {
    "type": "binary",
    "entry_point": "bin/perplexity-pp-mcp",
    "mcp_config": {
      "command": "${__dirname}/bin/perplexity-pp-mcp",
      "args": []
    }
  },
  "compatibility": {
    "claude_desktop": ">=1.0.0",
    "platforms": [
      "darwin",
      "linux",
      "win32"
    ]
  }
}
