{
  "manifest_version": "0.3",
  "name": "normattiva-pp-mcp",
  "display_name": "Normattiva",
  "version": "0.1.0",
  "description": "Italian law in your terminal: resolve citations, read any article at any date, diff versions and track amendments.",
  "author": {
    "name": "CLI Printing Press"
  },
  "license": "Apache-2.0",
  "server": {
    "type": "binary",
    "entry_point": "bin/normattiva-pp-mcp",
    "mcp_config": {
      "command": "${__dirname}/bin/normattiva-pp-mcp",
      "args": []
    }
  },
  "compatibility": {
    "claude_desktop": ">=1.0.0",
    "platforms": [
      "darwin",
      "linux",
      "win32"
    ]
  }
}
