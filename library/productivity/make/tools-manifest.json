{
  "api_name": "make",
  "base_url": "https://{zone}.make.com/api/v2",
  "description": "Make.com Management API (formerly Integromat) — scenarios, executions, connections, webhooks, data stores.",
  "mcp_ready": "full",
  "http_transport": "standard",
  "mcp": {
    "endpoint_tools": "hidden",
    "orchestration": "code"
  },
  "auth": {
    "type": "api_key",
    "header": "Authorization",
    "in": "header",
    "env_vars": [
      "MAKE_API_TOKEN"
    ],
    "env_var_specs": [
      {
        "name": "MAKE_API_TOKEN",
        "kind": "per_call",
        "required": true,
        "sensitive": true,
        "inferred": true
      }
    ],
    "key_url": "https://www.make.com/en/help/api/api-overview"
  },
  "required_headers": [],
