      "description": "Delete a connection. Required: connectionId. Destructive.",
      "method": "DELETE",
      "path": "/connections/{connectionId}",
      "params": [
        {
          "name": "connectionId",
          "type": "int",
          "location": "path",
          "description": "Connection ID",
          "required": true
        }
      ]
    },
    {
      "name": "connections_get",
