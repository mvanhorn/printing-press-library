{
  "manifest_version": "0.3",
  "name": "cal-com-pp-mcp",
  "display_name": "Cal Com",
  "version": "4.6.1",
  "description": "Cal Com API surface as MCP tools.",
  "author": {
    "name": "CLI Printing Press"
  },
  "license": "Apache-2.0",
  "server": {
    "type": "binary",
    "entry_point": "bin/cal-com-pp-mcp",
    "mcp_config": {
      "command": "${__dirname}/bin/cal-com-pp-mcp",
      "args": [],
      "env": {
        "CAL_API_KEY": "${user_config.cal_api_key}",
        "CAL_COM_API_KEY": "${user_config.cal_com_api_key}"
      }
    }
  },
  "user_config": {
    "cal_api_key": {
      "type": "string",
      "title": "CAL_API_KEY",
      "description": "Sets CAL_API_KEY for the Cal Com MCP server.",
      "sensitive": true,
      "required": true
    },
    "cal_com_api_key": {
      "type": "string",
      "title": "CAL_COM_API_KEY",
      "description": "Sets CAL_COM_API_KEY for the Cal Com MCP server.",
      "sensitive": true,
      "required": true
    }
  },
  "compatibility": {
    "claude_desktop": ">=1.0.0",
    "platforms": [
      "darwin",
      "linux",
      "win32"
    ]
  }
}
