{
  "manifest_version": "0.3",
  "name": "ihatepdf-cv-pp-mcp",
  "display_name": "ihatepdf.cv",
  "version": "1.0.0",
  "description": "Private PDF operations for agents, scripts, and offline pipelines.",
  "author": {
    "name": "CLI Printing Press"
  },
  "license": "Apache-2.0",
  "server": {
    "type": "binary",
    "entry_point": "bin/ihatepdf-cv-pp-mcp",
    "mcp_config": {
      "command": "${__dirname}/bin/ihatepdf-cv-pp-mcp",
      "args": [],
      "env": {
        "PRINTING_PRESS_CLIENT_PROFILE": "${user_config.printing_press_client_profile}"
      }
    }
  },
  "user_config": {
    "printing_press_client_profile": {
      "type": "string",
      "title": "Client profile",
      "description": "Binds the MCP server to an existing tenant-gated Printing Press client profile.",
      "required": true
    }
  },
  "compatibility": {
    "claude_desktop": ">=1.0.0",
    "platforms": [
      "darwin",
      "linux",
      "win32"
    ]
  }
}
