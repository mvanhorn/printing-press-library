{
  "api_name": "mobbin",
  "base_url": "https://mobbin.com",
  "description": "Mobbin design-inspiration CLI: search, browse, and save UI patterns from real shipped apps (web, iOS, Android) with a local offline store.",
  "mcp_ready": "ready",
  "http_transport": "standard",
  "auth": {
    "type": "cookie",
    "header": "Cookie",
    "in": "header",
    "cookie_domain": "mobbin.com"
  },
  "required_headers": [
    {
      "name": "User-Agent",
      "value": "mobbin-pp-cli/0.1.0 (+https://github.com/mvanhorn/cli-printing-press)"
    },
    {
      "name": "Accept",
      "value": "application/json, text/html, */*"
    },
    {
      "name": "Origin",
      "value": "https://mobbin.com"
    },
    {
      "name": "Referer",
      "value": "https://mobbin.com/"
    }
  ],
  "tools": [
    {
      "name": "mobbin_search",
      "description": "Search the compact Mobbin endpoint catalog by task and return endpoint ids, methods, paths, and summaries for agent planning.",
      "method": "SEARCH",
      "path": "internal://mobbin-search",
      "no_auth": true,
      "params": [
        {
          "name": "query",
          "type": "string",
          "location": "body",
          "description": "Task or resource to find",
          "required": true
        },
        {
          "name": "limit",
          "type": "int",
          "location": "body",
          "description": "Maximum matches"
        }
      ]
    },
    {
      "name": "mobbin_execute",
      "description": "Execute one Mobbin endpoint id returned by mobbin_search using JSON params for path placeholders, query strings, or request body fields.",
      "method": "POST",
      "path": "internal://mobbin-execute",
      "no_auth": false,
      "params": [
        {
          "name": "endpoint_id",
          "type": "string",
          "location": "body",
          "description": "Endpoint id from mobbin_search",
          "required": true
        },
        {
          "name": "params",
          "type": "object",
          "location": "body",
          "description": "Endpoint parameters"
        }
      ]
    },
    {
      "name": "context",
      "description": "Summarize Mobbin resources, authentication, and design research workflows before planning larger deck, audit, or parity tasks.",
      "method": "GET",
      "path": "internal://context",
      "no_auth": true,
      "params": []
    }
  ]
}
