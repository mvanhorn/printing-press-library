          "required": true
        }
      ]
    },
    {
      "name": "highlights_get-all",
      "description": "Retrieves all highlights from a user's bookmarks with pagination. Optional: page (default: 0), perpage (default: 25). Returns array of Highlight.",
      "method": "GET",
      "path": "/highlights",
      "params": [
        {
          "name": "page",
          "type": "int",
          "location": "query",
          "description": "Page number for pagination"
        },
        {
          "name": "perpage",
          "type": "int",
          "location": "query",
          "description": "Number of highlights per page (max 50)"
        }
      ]
    },
    {
      "name": "highlights_get-by-collection",
      "description": "Retrieves all highlights from bookmarks in a specific collection. Required: collectionId. Optional: page (default: 0), perpage (default: 25). Returns array of Highlight.",
      "method": "GET",
      "path": "/highlights/{collectionId}",
      "params": [
        {
          "name": "collectionId",
          "type": "int",
          "location": "path",
          "description": "Collection ID",
          "required": true
        },
        {
          "name": "page",
          "type": "int",
          "location": "query",
          "description": "Page number for pagination"
        },
        {
          "name": "perpage",
          "type": "int",
          "location": "query",
          "description": "Number of highlights per page (max 50)"
        }
      ]
    },
    {
      "name": "highlights_update",
