        {
          "name": "level",
          "type": "string",
          "location": "body",
          "description": "Sharing permission level",
          "required": true
        }
      ]
    },
    {
      "name": "collection_stats_get-collection",
      "description": "Retrieves statistics for a specific collection. Required: id. Returns the CollectionStatsResponse.",
      "method": "GET",
      "path": "/collection/{id}/stats",
      "params": [
        {
          "name": "id",
          "type": "int",
          "location": "path",
          "description": "Collection ID",
          "required": true
        }
      ]
    },
    {
      "name": "collections_get-all",
      "description": "Retrieves all collections for the authenticated user. Returns array of Collection.",
      "method": "GET",
      "path": "/collections",
      "params": []
    },
    {
      "name": "collections_remove-empty",
      "description": "Remove all empty collections from the account. Returns the updated CollectionsRemoveEmptyResponse.",
      "method": "PUT",
      "path": "/collections/clean",
      "params": []
