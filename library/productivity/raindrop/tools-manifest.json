      "path": "/file/{id}",
      "params": [
        {
          "name": "id",
          "type": "string",
          "location": "path",
          "description": "File ID",
          "required": true
        }
      ]
    },
    {
      "name": "file_get",
      "description": "Download or retrieve information about an uploaded file. Required: id.",
      "method": "GET",
      "path": "/file/{id}",
      "params": [
        {
          "name": "id",
          "type": "string",
          "location": "path",
          "description": "File ID",
          "required": true
        }
      ]
    },
    {
      "name": "filters_get-available",
