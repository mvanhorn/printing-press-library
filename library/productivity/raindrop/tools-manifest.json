      "method": "PUT",
      "path": "/collections",
      "params": [
        {
          "name": "expanded",
          "type": "bool",
          "location": "body",
          "description": "Expanded"
        },
        {
          "name": "sort",
          "type": "string",
          "location": "body",
          "description": "Sort"
        }
      ]
    },
    {
      "name": "collections_childrens_get-child-collections",
      "description": "Retrieves child collections of a specific parent collection. Required: parentId. Returns array of Collection.",
      "method": "GET",
      "path": "/collections/{parentId}/childrens",
      "params": [
        {
          "name": "parentId",
          "type": "int",
          "location": "path",
