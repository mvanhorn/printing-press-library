      "params": [
        {
          "name": "collectionId",
          "type": "int",
          "location": "path",
          "description": "Collection ID, or 0 for all bookmarks",
          "required": true
        }
      ]
    },
    {
      "name": "highlights_add-to-bookmark",
      "description": "Creates a new text highlight for a specific bookmark. Required: raindrop, text. Optional: color (default: yellow), note. Returns the new HighlightItemResponse.",
      "method": "POST",
      "path": "/highlights",
      "params": [
        {
          "name": "color",
          "type": "string",
          "location": "body",
          "description": "Highlight color"
        },
        {
          "name": "note",
          "type": "string",
          "location": "body",
          "description": "Optional note for the highlight"
        },
        {
          "name": "raindrop-id",
          "wire_name": "raindrop.$id",
          "type": "int",
          "location": "body",
          "description": "Id"
        },
        {
          "name": "text",
          "type": "string",
          "location": "body",
          "description": "Highlighted text",
          "required": true
        }
      ]
    },
    {
      "name": "highlights_delete",
      "description": "Permanently removes a highlight from a bookmark. Required: id. Destructive.",
      "method": "DELETE",
      "path": "/highlights/{id}",
      "params": [
        {
          "name": "id",
