{
  "api_name": "raindrop",
  "base_url": "https://api.raindrop.io/rest/v1",
  "description": "Complete Raindrop.io control plus offline search, safe cleanup, and durable knowledge workflows.",
  "mcp_ready": "full",
  "http_transport": "browser-chrome-h2",
  "mcp": {
    "endpoint_tools": "hidden",
    "orchestration": "code"
  },
  "auth": {
    "type": "bearer_token",
    "header": "Authorization",
    "env_vars": [
      "RAINDROP_TOKEN"
    ],
    "env_var_specs": [
      {
        "name": "RAINDROP_TOKEN",
        "kind": "per_call",
        "required": true,
        "sensitive": true,
        "inferred": true
      }
    ]
  },
  "required_headers": [],
  "tools": [
    {
      "name": "bookmark_transfer_export-bookmarks",
      "description": "Export bookmarks in various formats. Required: format. Optional: broken (default: false), collection, duplicates (default: false). Returns the new ExportResponse.",
      "method": "POST",
      "path": "/export",
      "params": [
        {
          "name": "broken",
          "type": "bool",
          "location": "body",
          "description": "Include broken bookmarks"
        },
        {
          "name": "collection",
          "type": "int",
          "location": "body",
          "description": "Collection ID to export (omit for all bookmarks)"
        },
        {
          "name": "duplicates",
          "type": "bool",
          "location": "body",
          "description": "Include duplicate bookmarks"
        },
        {
          "name": "format",
          "type": "string",
          "location": "body",
          "description": "Export format",
          "required": true
        }
      ]
    },
    {
      "name": "bookmark_transfer_import-bookmarks",
      "description": "Import bookmarks from files or external services. Required: file. Optional: collection, format, mode (default: add) (plus 1 more). Returns array of BookmarkTransferImportBookmarksItem.",
      "method": "POST",
      "path": "/import",
      "params": [
        {
          "name": "collection",
          "type": "string",
          "location": "body",
          "description": "Collection ID to import into"
        },
        {
          "name": "file",
          "type": "string",
          "location": "body",
          "description": "Bookmarks file to import",
          "required": true
        },
        {
          "name": "format",
          "type": "string",
          "location": "body",
          "description": "Format of the import file"
        },
        {
          "name": "mode",
          "type": "string",
          "location": "body",
          "description": "Import mode"
        },
        {
          "name": "parse",
          "type": "bool",
          "location": "body",
          "description": "Whether to parse content during import"
        }
      ]
    },
    {
      "name": "bookmark_transfer_import-from-url",
      "description": "Import bookmarks from a remote URL hosting a bookmarks file. Required: url. Optional: collection, parse (default: true). Returns the new ImportJobResponse.",
      "method": "POST",
      "path": "/import/url",
      "params": [
        {
          "name": "collection-id",
          "wire_name": "collection.$id",
          "type": "int",
          "location": "body",
          "description": "Id"
        },
        {
          "name": "collection-title",
          "wire_name": "collection.title",
          "type": "string",
          "location": "body",
          "description": "Title"
        },
        {
          "name": "parse",
          "type": "bool",
          "location": "body",
          "description": "Whether to parse imported bookmarks"
        },
        {
          "name": "url",
          "type": "string",
          "location": "body",
          "description": "URL of bookmarks file to import",
          "required": true
        }
      ]
    },
    {
      "name": "collection_create",
      "description": "Creates a new collection with the specified properties. Required: title. Optional: color, description, parent (plus 1 more). Returns the new CollectionItemResponse.",
      "method": "POST",
      "path": "/collection",
      "params": [
        {
          "name": "color",
          "type": "string",
          "location": "body",
          "description": "Collection color theme"
        },
        {
          "name": "description",
          "type": "string",
          "location": "body",
          "description": "Collection description"
        },
        {
          "name": "parent-id",
          "wire_name": "parent.$id",
          "type": "int",
          "location": "body",
          "description": "Id"
        },
        {
          "name": "public",
          "type": "bool",
          "location": "body",
          "description": "Whether collection should be public"
        },
        {
          "name": "title",
          "type": "string",
          "location": "body",
          "description": "Collection title",
          "required": true
        }
      ]
    },
    {
      "name": "collection_delete",
      "description": "Permanently deletes a collection and all its bookmarks. Required: id. Destructive.",
      "method": "DELETE",
      "path": "/collection/{id}",
      "params": [
        {
          "name": "id",
          "type": "int",
          "location": "path",
          "description": "Collection ID",
          "required": true
        }
      ]
    },
    {
      "name": "collection_empty-trash",
      "description": "Permanently delete all bookmarks in the trash collection. Returns the updated ResultResponse.",
      "method": "PUT",
      "path": "/collection/-99/clear",
      "params": []
    },
    {
      "name": "collection_get",
      "description": "Retrieves detailed information about a specific collection. Required: id. Returns the CollectionItemResponse.",
      "method": "GET",
      "path": "/collection/{id}",
      "params": [
        {
          "name": "id",
          "type": "int",
          "location": "path",
          "description": "Collection ID",
          "required": true
        }
      ]
    },
    {
      "name": "collection_update",
      "description": "Updates properties of an existing collection. Required: id. Optional: color, description, parent (plus 2 more). Returns the updated CollectionItemResponse.",
      "method": "PUT",
      "path": "/collection/{id}",
      "params": [
        {
          "name": "id",
          "type": "int",
          "location": "path",
          "description": "Collection ID",
          "required": true
        },
        {
          "name": "color",
          "type": "string",
          "location": "body",
          "description": "Collection color theme"
        },
        {
          "name": "description",
          "type": "string",
          "location": "body",
          "description": "Collection description"
        },
        {
          "name": "parent-id",
          "wire_name": "parent.$id",
          "type": "int",
          "location": "body",
          "description": "Id"
        },
        {
          "name": "public",
          "type": "bool",
          "location": "body",
          "description": "Whether collection should be public"
        },
        {
          "name": "title",
          "type": "string",
          "location": "body",
          "description": "Collection title"
        }
      ]
    },
    {
      "name": "collection_merge_collections",
      "description": "Merge multiple collections into a target collection. Required: id, with. Returns the updated ResultResponse.",
      "method": "PUT",
      "path": "/collection/{id}/merge",
      "params": [
        {
          "name": "id",
          "type": "int",
          "location": "path",
          "description": "Collection ID",
          "required": true
        },
        {
          "name": "with",
          "type": "array",
          "location": "body",
          "description": "Array of collection IDs to merge into the target",
          "required": true
        }
      ]
    },
    {
      "name": "collection_sharing_share-collection",
      "description": "Share a collection with specific users or generate public sharing link. Required: id, level. Optional: emails. Returns array of SharingShareCollectionItem.",
      "method": "PUT",
      "path": "/collection/{id}/sharing",
      "params": [
        {
          "name": "id",
          "type": "int",
          "location": "path",
          "description": "Collection ID",
          "required": true
        },
        {
          "name": "emails",
          "type": "string_csv_array",
          "location": "body",
          "description": "Email addresses to share with"
