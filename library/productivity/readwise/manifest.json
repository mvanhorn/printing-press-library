{
  "manifest_version": "0.3",
  "name": "readwise-pp-mcp",
  "display_name": "Readwise",
  "version": "0.1.0",
  "description": "Every Readwise and Reader feature, plus a local mirror of your whole library that you can search, triage and dedupe offline.",
  "author": {
    "name": "CLI Printing Press"
  },
  "license": "Apache-2.0",
  "server": {
    "type": "binary",
    "entry_point": "bin/readwise-pp-mcp",
    "mcp_config": {
      "command": "${__dirname}/bin/readwise-pp-mcp",
      "args": [],
      "env": {
        "READWISE_API_TOKEN": "${user_config.readwise_api_token}"
      }
    }
  },
  "user_config": {
    "readwise_api_token": {
      "type": "string",
      "title": "READWISE_API_TOKEN",
      "description": "Sets READWISE_API_TOKEN for the Readwise MCP server.",
      "sensitive": true,
      "required": true
    }
  },
  "compatibility": {
    "claude_desktop": ">=1.0.0",
    "platforms": [
      "darwin",
      "linux",
      "win32"
    ]
  }
}
