{
  "api_name": "odoo18cli",
  "base_url": "https://your-odoo.example.com",
  "description": "Generic Odoo 18 CLI covering the main business models: sales, purchases,\nproducts, partners, manufacturing, inventory, and accounting.\n\nConnects to the Odoo XML-RPC external API at /xmlrpc/2/common (auth)\nand /xmlrpc/2/object (ORM: search_read, read, create, write).\n\nSupports multiple Odoo instances via profiles:\n  odoo18cli --profile edarredo partners list --limit 10\n\nAuth: set ODOO_URL, ODOO_DB, ODOO_USER, ODOO_API_KEY environment variables.\nGenerate an API key in Odoo via Settings → Users → your user → Account Security.",
  "mcp_ready": "full",
  "http_transport": "standard",
  "auth": {
    "type": "api_key",
    "header": "X-Odoo-API-Key",
    "in": "header",
    "env_vars": [
      "ODOO_API_KEY"
    ],
    "env_var_specs": [
      {
        "name": "ODOO_API_KEY",
        "kind": "per_call",
        "required": true,
        "sensitive": true,
        "inferred": true
      }
    ]
  },
  "required_headers": [],
  "tools": [
    {
      "name": "xmlrpc_authenticate",
      "description": "Calls common.authenticate(db, username, api_key, {}) via XML-RPC. Returns integer UID used in all subsequent object calls. Optional: api_key, db, username.",
      "method": "POST",
      "path": "/xmlrpc/2/common",
      "params": [
        {
          "name": "api_key",
          "type": "string",
          "location": "body",
          "description": "Api key"
        },
        {
          "name": "db",
          "type": "string",
          "location": "body",
          "description": "Db"
        },
        {
          "name": "username",
          "type": "string",
          "location": "body",
          "description": "Username"
        }
      ]
    },
    {
      "name": "xmlrpc_confirm-sales-order",
      "description": "Confirm a quotation into a sales order. Required: id.",
      "method": "POST",
      "path": "/xmlrpc/2/object/sale.order/action_confirm",
      "params": [
        {
          "name": "id",
          "type": "int",
          "location": "body",
          "description": "Id",
          "required": true
        }
      ]
    },
    {
      "name": "xmlrpc_create-manufacturing-order",
      "description": "Create a new manufacturing order. Required: product_id, product_qty. Optional: bom_id, company_id, date_start.",
      "method": "POST",
      "path": "/xmlrpc/2/object/mrp.production/create",
      "params": [
        {
          "name": "bom_id",
          "type": "int",
          "location": "body",
          "description": "Bom id"
        },
        {
          "name": "company_id",
          "type": "int",
          "location": "body",
          "description": "Company id"
        },
        {
          "name": "date_start",
          "type": "string",
          "location": "body",
          "description": "Date start"
        },
        {
          "name": "product_id",
          "type": "int",
          "location": "body",
          "description": "Product id",
          "required": true
        },
        {
          "name": "product_qty",
          "type": "float",
          "location": "body",
          "description": "Product qty",
          "required": true
        }
      ]
    },
    {
      "name": "xmlrpc_create-partner",
      "description": "Create a new partner. Required: name. Optional: city, country_id, customer_rank (plus 6 more).",
      "method": "POST",
      "path": "/xmlrpc/2/object/res.partner/create",
      "params": [
        {
          "name": "city",
          "type": "string",
          "location": "body",
          "description": "City"
        },
        {
          "name": "country_id",
          "type": "int",
          "location": "body",
          "description": "Country id"
        },
        {
          "name": "customer_rank",
          "type": "int",
          "location": "body",
          "description": "Customer rank"
        },
        {
          "name": "email",
          "type": "string",
          "location": "body",
          "description": "Email"
        },
        {
          "name": "is_company",
          "type": "bool",
          "location": "body",
          "description": "Is company"
        },
        {
          "name": "name",
          "type": "string",
          "location": "body",
          "description": "Name",
          "required": true
        },
        {
          "name": "phone",
          "type": "string",
          "location": "body",
          "description": "Phone"
        },
        {
          "name": "street",
          "type": "string",
          "location": "body",
          "description": "Street"
        },
        {
          "name": "supplier_rank",
          "type": "int",
          "location": "body",
          "description": "Supplier rank"
        },
        {
          "name": "vat",
          "type": "string",
          "location": "body",
          "description": "Tax ID / VAT number"
        }
      ]
    },
    {
      "name": "xmlrpc_create-product",
      "description": "Create a new product template. Required: name. Optional: categ_id, default_code, list_price (plus 3 more).",
      "method": "POST",
      "path": "/xmlrpc/2/object/product.template/create",
      "params": [
        {
          "name": "categ_id",
          "type": "int",
          "location": "body",
          "description": "Categ id"
        },
        {
          "name": "default_code",
          "type": "string",
          "location": "body",
          "description": "Internal reference"
        },
        {
          "name": "list_price",
          "type": "float",
          "location": "body",
          "description": "Sales price"
        },
        {
          "name": "name",
          "type": "string",
          "location": "body",
          "description": "Name",
          "required": true
        },
        {
          "name": "standard_price",
          "type": "float",
          "location": "body",
          "description": "Cost"
        },
        {
          "name": "type",
          "type": "string",
          "location": "body",
          "description": "consu=consumable, service=service, product=storable"
        },
        {
          "name": "uom_id",
          "type": "int",
          "location": "body",
          "description": "Uom id"
        }
      ]
    },
    {
      "name": "xmlrpc_create-purchase-order",
      "description": "Create a new purchase order (RFQ). Required: partner_id. Optional: date_order, notes, payment_term_id (plus 1 more).",
      "method": "POST",
      "path": "/xmlrpc/2/object/purchase.order/create",
      "params": [
        {
          "name": "date_order",
          "type": "string",
          "location": "body",
          "description": "Date order"
        },
        {
          "name": "notes",
          "type": "string",
          "location": "body",
          "description": "Notes"
        },
        {
          "name": "partner_id",
          "type": "int",
          "location": "body",
          "description": "Vendor partner ID",
          "required": true
        },
        {
          "name": "payment_term_id",
          "type": "int",
          "location": "body",
          "description": "Payment term id"
        },
        {
          "name": "user_id",
          "type": "int",
          "location": "body",
          "description": "User id"
        }
      ]
    },
    {
      "name": "xmlrpc_create-sales-order",
      "description": "Create a new sales order. Required: partner_id. Optional: date_order, note, payment_term_id (plus 2 more).",
      "method": "POST",
      "path": "/xmlrpc/2/object/sale.order/create",
      "params": [
        {
          "name": "date_order",
          "type": "string",
          "location": "body",
          "description": "Date order"
        },
        {
          "name": "note",
          "type": "string",
          "location": "body",
          "description": "Note"
        },
        {
          "name": "partner_id",
          "type": "int",
          "location": "body",
          "description": "Customer partner ID",
          "required": true
        },
        {
          "name": "payment_term_id",
          "type": "int",
          "location": "body",
          "description": "Payment term id"
        },
        {
          "name": "team_id",
          "type": "int",
          "location": "body",
          "description": "Sales team ID"
        },
        {
          "name": "user_id",
          "type": "int",
          "location": "body",
          "description": "Salesperson ID"
        }
      ]
    },
