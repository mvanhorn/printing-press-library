{
  "openapi": "3.1.0",
  "info": {
    "title": "SkoolAPI.com",
    "version": "1.0.0",
    "description": "Command your Skool community from the terminal: posts, members, chats, webhooks. Native SkoolAPI.com endpoints plus a local SQLite mirror and Apify CRUD layer."
  },
  "servers": [
    {
      "url": "https://api.skoolapi.com"
    }
  ],
  "tags": [
    {
      "name": "Sessions",
      "description": "Represent authenticated connections to individual Skool accounts"
    },
    {
      "name": "Webhooks",
      "description": "Notify your application when specific events occur in your Skool community"
    },
    {
      "name": "Chats",
      "description": "Resources for interacting with other Skool accounts through the chat"
    },
    {
      "name": "Posts",
      "description": "Access Skool posts from your community and interact with them"
    }
  ],
