{
  "manifest_version": "0.3",
  "name": "trello-pp-mcp",
  "display_name": "Trello",
  "version": "4.20.1",
  "description": "Every Trello feature, plus a local SQLite mirror, offline search, and cross-board analytics no other Trello tool has.",
  "author": {
    "name": "CLI Printing Press"
  },
  "license": "Apache-2.0",
  "server": {
    "type": "binary",
    "entry_point": "bin/trello-pp-mcp",
    "mcp_config": {
      "command": "${__dirname}/bin/trello-pp-mcp",
      "args": [],
      "env": {
        "TRELLO_API_KEY": "${user_config.trello_api_key}"
      }
    }
  },
  "user_config": {
    "trello_api_key": {
      "type": "string",
      "title": "TRELLO_API_KEY",
      "description": "Sets TRELLO_API_KEY for the Trello MCP server.",
      "sensitive": true,
      "required": true
    }
  },
  "compatibility": {
    "claude_desktop": ">=1.0.0",
    "platforms": [
      "darwin",
      "linux",
      "win32"
    ]
  }
}
