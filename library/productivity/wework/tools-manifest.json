          "location": "body",
          "description": "Notes"
        },
        {
          "name": "PlatFormTypeEnum",
          "type": "int",
          "location": "body",
          "description": "Plat form type enum"
        },
        {
          "name": "ReservationID",
          "type": "string",
          "location": "body",
          "description": "Reservation id"
        },
        {
          "name": "SpaceID",
          "type": "string",
          "location": "body",
          "description": "Space id"
        },
        {
          "name": "SpaceType",
          "type": "string",
          "location": "body",
          "description": "Space type"
