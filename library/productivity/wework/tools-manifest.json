{
  "api_name": "wework",
  "base_url": "https://members.wework.com/workplaceone/api",
  "description": "Find and book WeWork day-desks from the terminal — cities, buildings, availability, price, and your bookings — with a local store for instant, agent-native queries.",
  "mcp_ready": "full",
  "http_transport": "browser-chrome",
  "auth": {
    "type": "bearer_token",
    "header": "Authorization",
    "env_vars": [
      "WEWORK_TOKEN"
    ],
    "env_var_specs": [
      {
        "name": "WEWORK_TOKEN",
        "kind": "per_call",
        "required": true,
        "sensitive": true,
        "inferred": true
      }
    ]
  },
  "required_headers": [],
  "tools": [
    {
      "name": "common-booking_book-desk",
      "description": "Creates a real desk reservation and charges the member's saved payment account. Verified against a live booking on 2026-08-12 (801 Barton Springs Rd, $47). Recommended flow: quote first, then book. Returns ReservationID + BookingStatus. The generated command should default to --dry-run; require an explicit confirm flag to charge. Optional: ApplicationType, CardUuid, CreditCharged (plus 15 more).",
      "method": "POST",
      "path": "/common-booking/",
      "params": [
        {
          "name": "ApplicationType",
          "type": "int",
          "location": "body",
          "description": "Application type"
        },
        {
          "name": "CardUuid",
          "type": "string",
          "location": "body",
          "description": "Saved payment account UUID (book only)"
