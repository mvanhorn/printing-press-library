{
  "manifest_version": "0.3",
  "name": "wework-pp-mcp",
  "display_name": "Wework Workplaceone",
  "version": "4.30.2",
  "description": "Wework Workplaceone API surface as MCP tools.",
  "author": {
    "name": "CLI Printing Press"
  },
  "license": "Apache-2.0",
  "server": {
    "type": "binary",
    "entry_point": "bin/wework-pp-mcp",
    "mcp_config": {
      "command": "${__dirname}/bin/wework-pp-mcp",
      "args": [],
      "env": {
        "WEWORK_TOKEN": "${user_config.wework_token}",
        "PRINTING_PRESS_CLIENT_PROFILE": "${user_config.printing_press_client_profile}"
      }
    }
  },
  "user_config": {
    "wework_token": {
      "type": "string",
      "title": "WeWork access token",
      "description": "WeWork WorkplaceOne bearer access token",
      "sensitive": true,
      "required": true
    },
    "printing_press_client_profile": {
      "type": "string",
      "title": "Client profile",
      "description": "Binds the MCP server to an existing tenant-gated Printing Press client profile.",
      "required": true
    }
  },
  "compatibility": {
    "claude_desktop": ">=1.0.0",
    "platforms": [
      "darwin",
      "linux",
      "win32"
    ]
  }
}
