+// An explicit example home identifies its intended store; fixture defaults
+// must not redirect that command to a different store.
+func liveDogfoodHasExplicitHome(args, commandPath []string, positionalCount int, valueFlags map[string]struct{}) bool {
+	start := min(len(commandPath), len(args))
+	for i := start; i < len(args); i++ {
+		arg := args[i]
+		if arg == "--" {
+			break
+		}
+		if arg == "--home" || strings.HasPrefix(arg, "--home=") {
+			return true
+		}
+		_, typedValue := valueFlags[strings.TrimPrefix(arg, "--")]
+		if isLiveDogfoodFlagToken(arg) && !strings.Contains(arg, "=") && i+1 < len(args) &&
+			(typedValue || liveDogfoodFlagHasSeparateValueWithTypes(args, start, i, positionalCount, valueFlags)) {
+			i++
+		}
+	}
+	return false
 }
 
