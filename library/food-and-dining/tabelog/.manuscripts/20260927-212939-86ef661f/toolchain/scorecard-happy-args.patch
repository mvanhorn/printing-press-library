+package pipeline
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+)
+
+const fixtureListHelp = `Usage:
+  bin lists compare <list> [id...] [flags]
+
+Flags:
+      --agent         Compact JSON
+      --format string Output format
+      --home string   Store root
+      --note string   Note text
+`
+
+func TestRunOneFeatureCheckUsesHappyArgsOverlay(t *testing.T) {
+	dir := t.TempDir()
+	argsPath := filepath.Join(dir, "received-args.txt")
+	binary := writeStubBinary(t, dir, "fixture-cli", fmt.Sprintf(`if [ "${3:-}" = "--help" ]; then
+cat <<'HELP'
+%s
+HELP
+exit 0
+fi
+printf '%%s\n' "$@" > %q
+printf '{"items":[{"id":"13005012","name":"Fixture restaurant"}],"list":"fixture-list"}\n'`, fixtureListHelp, argsPath))
+	feature := liveCheckFeature{
+		NovelFeature: NovelFeature{Name: "saved comparison", Command: "lists compare", Example: "bin lists compare public-list old-id --format=summary --agent"},
+		Path:         []string{"lists", "compare"},
+		Annotations:  map[string]string{mcpReadOnlyAnnotation: "true", happyArgsAnnotation: "<list>=fixture-list;<id>=13005012;--format=json;--home=.printing-press-fixtures/live-home"},
+	}
+	result := runOneFeatureCheckWithDataSource(dir, binary, feature, time.Second, false)
+	require.Equal(t, StatusPass, result.Status, result.Reason)
+	got, err := os.ReadFile(argsPath)
+	require.NoError(t, err)
+	want := []string{"lists", "compare", "fixture-list", "13005012", "--format=json", "--agent", "--home", filepath.Join(dir, ".printing-press-fixtures", "live-home")}
+	require.Equal(t, strings.Join(want, "\n")+"\n", string(got))
+	require.Equal(t, feature.Example, result.Example, "public research examples must remain unchanged")
+}
+
+func TestRunOneFeatureCheckPreservesUnannotatedExample(t *testing.T) {
+	dir := t.TempDir()
+	argsPath := filepath.Join(dir, "received-args.txt")
+	binary := writeStubBinary(t, dir, "fixture-cli", fmt.Sprintf(`printf '%%s\n' "$@" > %q
+printf '{"items":[{"id":"13005012","name":"Restaurant"}],"list":"public-list"}\n'`, argsPath))
+	feature := liveCheckFeature{NovelFeature: NovelFeature{Name: "saved comparison", Command: "lists compare", Example: "bin lists compare public-list --agent"}, Path: []string{"lists", "compare"}, Annotations: map[string]string{mcpReadOnlyAnnotation: "true"}}
+	result := runOneFeatureCheckWithDataSource(dir, binary, feature, time.Second, false)
+	require.Equal(t, StatusPass, result.Status, result.Reason)
+	got, err := os.ReadFile(argsPath)
+	require.NoError(t, err)
+	require.Equal(t, "lists\ncompare\npublic-list\n--agent\n", string(got))
+}
+
+func TestHappyArgsHomePrecedenceSharedByRunners(t *testing.T) {
+	dir := t.TempDir()
+	cases := []struct {
+		name    string
+		example string
+		home    []string
+	}{
+		{"annotation default resolves from checkout", "bin lists compare public-list old-id --format=summary --agent", []string{"--home", filepath.Join(dir, ".printing-press-fixtures", "live-home")}},
+		{"explicit equals home wins", "bin lists compare public-list old-id --home=/chosen/home --format=summary --agent", []string{"--home=/chosen/home"}},
+		{"explicit separated home wins", "bin lists compare public-list old-id --home /chosen/home --format=summary --agent", []string{"--home", "/chosen/home"}},
+		{"explicit relative home is preserved", "bin lists compare public-list old-id --home=chosen-home --format=summary --agent", []string{"--home=chosen-home"}},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			command := liveDogfoodCommand{Path: []string{"lists", "compare"}, Help: fixtureListHelp + "\nExamples:\n  " + tc.example + "\n", Annotations: map[string]string{happyArgsAnnotation: "<list>=fixture-list;<id>=13005012;--format=json;--home=.printing-press-fixtures/live-home"}}
+			exampleArgs, err := parseExampleArgs(tc.example)
+			require.NoError(t, err)
+			scorecardArgs, err := overlayLiveDogfoodHappyArgs(exampleArgs, command, parseHappyArgsAnnotation(command.Annotations[happyArgsAnnotation]), dir)
+			require.NoError(t, err)
+			dogfoodArgs, ok, _, err := liveDogfoodHappyArgsParsed(command, dir)
+			require.NoError(t, err)
+			require.True(t, ok)
+			require.Equal(t, scorecardArgs, dogfoodArgs, "both runners must execute the same fixture args")
+			require.Equal(t, []string{"lists", "compare", "fixture-list", "13005012"}, scorecardArgs[:4])
+			require.Contains(t, scorecardArgs, "--format=json", "non-home annotation flag precedence must remain authoritative")
+			var home []string
+			for i, arg := range scorecardArgs {
+				if strings.HasPrefix(arg, "--home=") {
+					home = append(home, arg)
+				} else if arg == "--home" {
+					home = append(home, arg, scorecardArgs[i+1])
+				}
+			}
+			require.Equal(t, tc.home, home, "there must be exactly one non-conflicting home flag")
+		})
+	}
+}
+
+func TestHappyArgsHomeDetectionHonorsFlagValuesAndTerminator(t *testing.T) {
+	valueFlags := liveDogfoodFlagValueNames(fixtureListHelp)
+	require.False(t, liveDogfoodHasExplicitHome([]string{"lists", "compare", "list", "--note", "--home"}, []string{"lists", "compare"}, 2, valueFlags))
+	require.False(t, liveDogfoodHasExplicitHome([]string{"lists", "compare", "list", "--", "--home=/positional"}, []string{"lists", "compare"}, 2, valueFlags))
+}
