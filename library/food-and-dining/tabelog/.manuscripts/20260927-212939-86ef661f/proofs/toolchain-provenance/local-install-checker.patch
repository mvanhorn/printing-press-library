+package cli
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/mvanhorn/cli-printing-press/v4/internal/generator"
+	"github.com/stretchr/testify/require"
+)
+
+func TestCanonicalSectionsLocalModuleInstallContract(t *testing.T) {
+	t.Parallel()
+	local := fmt.Sprintf(canonicalLocalSkillInstallSectionFormat, "myapi")
+	public := generator.CanonicalSkillInstallSection("myapi", "productivity")
+	cases := []struct {
+		name        string
+		module      string
+		section     string
+		wantFinding bool
+	}{
+		{"exact local module with checkout install", "myapi-pp-cli", local, false},
+		{"local checkout with CRLF", "myapi-pp-cli", strings.ReplaceAll(local, "\n", "\r\n"), false},
+		{"local generated public block remains compatible", "myapi-pp-cli", public, false},
+		{"published module with public install", "github.com/mvanhorn/printing-press-library/library/productivity/myapi", public, false},
+		{"published module cannot use local exception", "github.com/mvanhorn/printing-press-library/library/productivity/myapi", local, true},
+		{"other qualified module cannot use local exception", "github.com/example/myapi-pp-cli", local, true},
+		{"different bare module cannot use local exception", "different-pp-cli", local, true},
+		{"local install command drift", "myapi-pp-cli", strings.Replace(local, "go install ./cmd/myapi-pp-cli", "go install ./cmd/nonexistent", 1), true},
+		{"local verification drift", "myapi-pp-cli", strings.Replace(local, "Verify: `myapi-pp-cli --version`", "Verify: `myapi-pp-cli --help`", 1), true},
+		{"local missing start delimiter", "myapi-pp-cli", strings.Replace(local, generator.SkillInstallSectionStartHeading, "## Install", 1), true},
+		{"local missing end delimiter", "myapi-pp-cli", strings.Replace(local, generator.SkillInstallSectionEndSubstr, "", 1), true},
+		{"published flag strip still fails", "github.com/example/myapi-pp-cli", strings.Replace(public, " --cli-only", "", 1), true},
+		{"local public flag strip still fails", "myapi-pp-cli", strings.Replace(public, " --cli-only", "", 1), true},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Parallel()
+			dir := writeLocalCanonicalFixture(t, "module "+tc.module+"\n\ngo 1.26.6\n", tc.section)
+			finding, hasFinding, skipped, err := runCanonicalSectionsCheck(dir)
+			require.NoError(t, err)
+			require.False(t, skipped, "local installation must be checked, never skipped")
+			require.Equal(t, tc.wantFinding, hasFinding)
+			if tc.wantFinding {
+				require.Equal(t, canonicalSectionsCheckName, finding.Check)
+				require.Equal(t, "error", finding.Severity)
+				require.NotEmpty(t, finding.Evidence)
+			}
+		})
+	}
+}
+
+func TestCanonicalSectionsGoModEvidence(t *testing.T) {
+	t.Parallel()
+	local := fmt.Sprintf(canonicalLocalSkillInstallSectionFormat, "myapi")
+	cases := []struct {
+		name    string
+		goMod   string
+		wantErr string
+	}{
+		{"quoted exact module and comment", "// local module\nmodule \"myapi-pp-cli\" // checkout\n\ngo 1.26.6\n", ""},
+		{"malformed module directive", "module myapi-pp-cli unexpected\n", "parsing go.mod"},
+		{"malformed version directive", "module myapi-pp-cli\ngo invalid\n", "parsing go.mod"},
+		{"missing module directive", "go 1.26.6\n", "must declare a module path"},
+		{"empty module file", "", "must declare a module path"},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Parallel()
+			dir := writeLocalCanonicalFixture(t, tc.goMod, local)
+			_, hasFinding, skipped, err := runCanonicalSectionsCheck(dir)
+			require.False(t, skipped, "invalid module evidence must fail, never skip the check")
+			require.False(t, hasFinding)
+			if tc.wantErr == "" {
+				require.NoError(t, err)
+			} else {
+				require.ErrorContains(t, err, tc.wantErr)
+			}
+		})
+	}
+}
+
+func TestCanonicalSectionsMissingGoModStillSkipsMinimalFixture(t *testing.T) {
+	t.Parallel()
+	dir := writeLocalCanonicalFixture(t, "module myapi-pp-cli\n", "")
+	require.NoError(t, os.Remove(filepath.Join(dir, "go.mod")))
+	_, hasFinding, skipped, err := runCanonicalSectionsCheck(dir)
+	require.NoError(t, err)
+	require.False(t, hasFinding)
+	require.True(t, skipped)
+}
+
+func TestCanonicalSectionsUnreadableGoModFails(t *testing.T) {
+	t.Parallel()
+	dir := writeLocalCanonicalFixture(t, "module myapi-pp-cli\n", "")
+	require.NoError(t, os.Remove(filepath.Join(dir, "go.mod")))
+	require.NoError(t, os.Mkdir(filepath.Join(dir, "go.mod"), 0o755))
+	_, hasFinding, skipped, err := runCanonicalSectionsCheck(dir)
+	require.ErrorContains(t, err, "reading go.mod")
+	require.False(t, hasFinding)
+	require.False(t, skipped)
+}
+
+func writeLocalCanonicalFixture(t *testing.T, goMod, section string) string {
+	t.Helper()
+	dir := t.TempDir()
+	require.NoError(t, os.WriteFile(filepath.Join(dir, ".printing-press.json"), []byte(`{"api_name":"myapi","cli_name":"myapi-pp-cli","category":"productivity"}`), 0o644))
+	require.NoError(t, os.WriteFile(filepath.Join(dir, "go.mod"), []byte(goMod), 0o644))
+	require.NoError(t, os.WriteFile(filepath.Join(dir, "SKILL.md"), []byte("# My API\n\n"+section+"\n## Workflow\n"), 0o644))
+	return dir
+}
