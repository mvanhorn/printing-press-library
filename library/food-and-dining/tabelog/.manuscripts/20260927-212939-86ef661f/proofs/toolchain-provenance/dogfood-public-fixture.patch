+func TestLiveDogfoodApprovedLocalFixtureExecutesOnce(t *testing.T) {
+	dir := t.TempDir()
+	home := filepath.Join(dir, ".printing-press-fixtures", "live-home")
+	require.NoError(t, os.MkdirAll(home, 0700))
+	counter := filepath.Join(home, "mutation-count")
+	help := "Usage:\n  fixture remove [flags]\n\nExamples:\n  fixture remove --json\n\nFlags:\n      --home string Store root\n      --json Output JSON\n      --dry-run Preview only\n"
+	binary := writeStubBinary(t, dir, "fixture-cli", fmt.Sprintf(`if [ "${2:-}" = "--help" ]; then
+cat <<'HELP'
+%s
+HELP
+exit 0
+fi
+case " $* " in *" --dry-run "*) printf '{"dry_run":true,"action":"remove"}\n'; exit 0 ;; esac
+n=0
+if [ -f %q ]; then n=$(cat %q); fi
+n=$((n + 1))
+printf '%%s\n' "$n" > %q
+if [ "$n" -gt 1 ]; then printf 'membership missing\n' >&2; exit 8; fi
+printf '{"removed":1}\n'
+`, help, counter, counter, counter))
+	command := liveDogfoodCommand{Path: []string{"remove"}, Annotations: map[string]string{mcpLocalWriteAnnotation: "true", "pp:happy-args": "--home=.printing-press-fixtures/live-home;--json=true"}}
+	results := runLiveDogfoodCommand(command, resolveCtx{binaryPath: binary, cliDir: dir, timeout: time.Second, allowDestructive: true})
+	for _, kind := range []LiveDogfoodTestKind{LiveDogfoodTestHappy, LiveDogfoodTestJSON, LiveDogfoodTestDryRunJSON} {
+		result := resultOfKind(t, results, kind)
+		require.Equal(t, LiveDogfoodStatusPass, result.Status, result.Reason)
+		if kind != LiveDogfoodTestDryRunJSON {
+			require.NotContains(t, result.Args, "--dry-run")
+		}
+	}
+	raw, err := os.ReadFile(counter)
+	require.NoError(t, err)
+	require.Equal(t, "1", strings.TrimSpace(string(raw)))
+}
