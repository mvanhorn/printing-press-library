+func TestLiveDogfoodStrictDryRunEnvelope(t *testing.T) {
+	for _, tc := range []struct {
+		name, payload string
+		pass          bool
+	}{
+		{"source action", `{"items":[{"action":"find","dry_run":true}],"meta":{"source":"dry-run"}}`, true},
+		{"coverage operation", `{"items":[{"operation":"remove","planned":true}],"meta":{"coverage":"dry_run"}}`, true},
+		{"every item planned", `{"items":[{"operation":"note","planned":true},{"action":"show","dry_run":true}],"meta":{"source":"dry-run"}}`, true},
+		{"ordinary data", `{"items":[{"id":"123","name":"venue"}],"meta":{"source":"live"}}`, false},
+		{"no meta marker", `{"items":[{"action":"find","dry_run":true}],"meta":{"source":"local"}}`, false},
+		{"empty items", `{"items":[],"meta":{"source":"dry-run"}}`, false},
+		{"missing items", `{"meta":{"source":"dry-run"}}`, false},
+		{"wrong items type", `{"items":{},"meta":{"source":"dry-run"}}`, false},
+		{"no action", `{"items":[{"planned":true}],"meta":{"coverage":"dry_run"}}`, false},
+		{"whitespace action", `{"items":[{"action":"  ","dry_run":true}],"meta":{"source":"dry-run"}}`, false},
+		{"no true marker", `{"items":[{"operation":"remove"}],"meta":{"coverage":"dry_run"}}`, false},
+		{"false marker", `{"items":[{"operation":"remove","planned":false}],"meta":{"coverage":"dry_run"}}`, false},
+		{"string marker", `{"items":[{"operation":"remove","planned":"true"}],"meta":{"coverage":"dry_run"}}`, false},
+		{"contradictory markers", `{"items":[{"operation":"remove","planned":false,"dry_run":true}],"meta":{"coverage":"dry_run"}}`, false},
+		{"mixed plans and data", `{"items":[{"operation":"remove","planned":true},{"id":"123"}],"meta":{"coverage":"dry_run"}}`, false},
+		{"legacy missing action remains failure", `{"dry_run":true,"action":"","items":[{"operation":"remove","planned":true}],"meta":{"coverage":"dry_run"}}`, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			status, reason := liveDogfoodDryRunJSONContract(liveDogfoodRun{stdout: tc.payload}, false)
+			if tc.pass {
+				require.Equal(t, LiveDogfoodStatusPass, status, reason)
+			} else {
+				require.NotEqual(t, LiveDogfoodStatusPass, status)
+			}
+		})
+	}
+}
