+// Live local writes require an explicit prepared fixture home. Remote mutation
+// policy is unchanged, even when an endpoint also advertises local writes.
+func liveDogfoodApprovedLocalFixture(command liveDogfoodCommand, args []string, ctx resolveCtx) bool {
+	if !ctx.allowDestructive || !annotationIsTrueValue(command.Annotations[mcpLocalWriteAnnotation]) {
+		return false
+	}
+	if method := strings.ToUpper(strings.TrimSpace(command.Annotations[endpointMethodAnnotation])); method != "" && method != "GET" && method != "HEAD" {
+		return false
+	}
+	valueFlags := liveDogfoodFlagValueNames(command.Help)
+	positionalCount := len(extractPositionalPlaceholders(liveDogfoodUsageSuffix(command.Help)))
+	start := min(len(command.Path), len(args))
+	home := ""
+	for i := start; i < len(args); i++ {
+		arg := args[i]
+		if arg == "--" {
+			break
+		}
+		if arg == "--home" || strings.HasPrefix(arg, "--home=") {
+			if home != "" {
+				return false
+			}
+			if arg == "--home" {
+				if i+1 >= len(args) {
+					return false
+				}
+				i++
+				home = args[i]
+			} else {
+				home = strings.TrimPrefix(arg, "--home=")
+			}
+			if home == "" {
+				return false
+			}
+			continue
+		}
+		_, typedValue := valueFlags[strings.TrimPrefix(arg, "--")]
+		if isLiveDogfoodFlagToken(arg) && !strings.Contains(arg, "=") && i+1 < len(args) &&
+			(typedValue || liveDogfoodFlagHasSeparateValueWithTypes(args, start, i, positionalCount, valueFlags)) {
+			i++
+		}
+	}
+	if !filepath.IsAbs(home) || ctx.cliDir == "" {
+		return false
+	}
+	cliDir, err := filepath.Abs(ctx.cliDir)
+	if err != nil {
+		return false
+	}
+	fixtureDir := filepath.Join(cliDir, ".printing-press-fixtures")
+	inside := func(root, path string) bool {
+		rel, err := filepath.Rel(root, path)
+		return err == nil && rel != ".." && !strings.HasPrefix(rel, ".."+string(filepath.Separator)) && !filepath.IsAbs(rel)
+	}
+	if !inside(fixtureDir, filepath.Clean(home)) {
+		return false
+	}
+	realCLI, err := filepath.EvalSymlinks(cliDir)
+	if err != nil {
+		return false
+	}
+	realFixture, err := filepath.EvalSymlinks(fixtureDir)
+	if err != nil || realFixture != filepath.Join(realCLI, ".printing-press-fixtures") {
+		return false
+	}
+	realHome, err := filepath.EvalSymlinks(home)
+	return err == nil && inside(realFixture, realHome)
 }
 
