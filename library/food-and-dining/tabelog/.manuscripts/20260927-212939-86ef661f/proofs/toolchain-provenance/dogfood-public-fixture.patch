+func TestLiveDogfoodLocalFixtureConfinement(t *testing.T) {
+	dir := t.TempDir()
+	home := filepath.Join(dir, ".printing-press-fixtures", "live-home")
+	require.NoError(t, os.MkdirAll(home, 0700))
+	outside := t.TempDir()
+	command := liveDogfoodCommand{Path: []string{"remove"}, Help: "Usage:\n  fixture remove [flags]\n\nFlags:\n      --home string Store root\n      --note string Personal note\n", Annotations: map[string]string{mcpLocalWriteAnnotation: "true"}}
+	ctx := resolveCtx{cliDir: dir, allowDestructive: true}
+	for _, tc := range []struct {
+		name                       string
+		args                       []string
+		allow, local, remote, want bool
+	}{
+		{"equals", []string{"remove", "--home=" + home}, true, true, false, true},
+		{"space", []string{"remove", "--home", home}, true, true, false, true},
+		{"no authorization", []string{"remove", "--home", home}, false, true, false, false},
+		{"no local annotation", []string{"remove", "--home", home}, true, false, false, false},
+		{"remote post", []string{"remove", "--home", home}, true, true, true, false},
+		{"operator home", []string{"remove", "--home", outside}, true, true, false, false},
+		{"no home", []string{"remove"}, true, true, false, false},
+		{"relative home", []string{"remove", "--home", ".printing-press-fixtures/live-home"}, true, true, false, false},
+		{"conflicting homes", []string{"remove", "--home", home, "--home=" + outside}, true, true, false, false},
+		{"home after separator is data", []string{"remove", "--", "--home=" + home}, true, true, false, false},
+		{"home as note is data", []string{"remove", "--note", "--home=" + home}, true, true, false, false},
+		{"note then real home", []string{"remove", "--note", "--home=" + outside, "--home", home}, true, true, false, true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			copy := command
+			copy.Annotations = map[string]string{}
+			if tc.local {
+				copy.Annotations[mcpLocalWriteAnnotation] = "true"
+			}
+			if tc.remote {
+				copy.Annotations[endpointMethodAnnotation] = "POST"
+			}
+			copyCtx := ctx
+			copyCtx.allowDestructive = tc.allow
+			require.Equal(t, tc.want, liveDogfoodApprovedLocalFixture(copy, tc.args, copyCtx))
+		})
+	}
+	linkedHome := filepath.Join(dir, ".printing-press-fixtures", "linked-home")
+	exact := command
+	exact.Path = []string{"lists", "remove"}
