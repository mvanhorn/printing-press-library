+func liveDogfoodDryRunEnvelope(payload map[string]any) (LiveDogfoodStatus, string, bool) {
+	meta, ok := payload["meta"].(map[string]any)
+	if !ok || (meta["source"] != "dry-run" && meta["coverage"] != "dry_run") {
+		return "", "", false
+	}
+	items, ok := payload["items"].([]any)
+	if !ok || len(items) == 0 {
+		return LiveDogfoodStatusFail, "empty or missing dry-run items", true
+	}
+	for _, item := range items {
+		plan, ok := item.(map[string]any)
+		if !ok {
+			return LiveDogfoodStatusFail, "non-plan dry-run item", true
+		}
+		action, _ := plan["action"].(string)
+		operation, _ := plan["operation"].(string)
+		if strings.TrimSpace(action) == "" && strings.TrimSpace(operation) == "" {
+			return LiveDogfoodStatusFail, "empty dry-run action", true
+		}
+		marked := false
+		for _, key := range []string{"dry_run", "planned"} {
+			if value, exists := plan[key]; exists {
+				flag, typed := liveDogfoodJSONBool(value)
+				if !typed || !flag {
+					return LiveDogfoodStatusFail, "non-plan dry-run item", true
+				}
+				marked = true
+			}
+		}
+		if !marked {
+			return LiveDogfoodStatusFail, "non-plan dry-run item", true
+		}
+	}
+	return LiveDogfoodStatusPass, "", true
 }
 
