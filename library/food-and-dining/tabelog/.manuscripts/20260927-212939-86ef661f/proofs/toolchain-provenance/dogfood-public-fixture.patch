+func TestLiveDogfoodHiddenAndOverviewDoNotExecuteHappy(t *testing.T) {
+	dir := t.TempDir()
+	counter := filepath.Join(dir, "called")
+	binary := writeStubBinary(t, dir, "fixture-cli", fmt.Sprintf(`if [ "${2:-}" = "--help" ]; then
+  printf 'Examples:\n  fixture group child --json\n'
+  exit 0
+fi
+printf 'unexpected\n' >> %q
+exit 77
+`, counter))
+	var commands []liveDogfoodCommand
+	collectLiveDogfoodCommands(nil, dogfoodAgentCommand{Name: "hidden", Hidden: true, Subcommands: []dogfoodAgentCommand{{Name: "child", Runnable: true}}}, &commands)
+	collectLiveDogfoodCommands(nil, dogfoodAgentCommand{Name: "group", Subcommands: []dogfoodAgentCommand{{Name: "child", Runnable: true}}}, &commands)
+	collectLiveDogfoodCommands(nil, dogfoodAgentCommand{Name: "runnable", Runnable: true, Subcommands: []dogfoodAgentCommand{{Name: "child", Runnable: true}}}, &commands)
+	for _, command := range commands {
+		name := strings.Join(command.Path, " ")
+		if name == "hidden" || name == "hidden child" || name == "group" {
+			results := runLiveDogfoodCommand(command, resolveCtx{binaryPath: binary, cliDir: dir, timeout: time.Second})
+			if strings.HasPrefix(name, "hidden") {
+				for _, result := range results {
+					require.Equal(t, LiveDogfoodStatusSkip, result.Status)
+					require.Contains(t, result.Reason, "hidden")
+				}
+			} else {
+				require.Len(t, results, 1)
+				require.Equal(t, LiveDogfoodTestHelp, results[0].Kind)
+				require.Equal(t, LiveDogfoodStatusPass, results[0].Status)
+			}
+		}
+		if name == "runnable" {
+			require.False(t, command.HelpOnly, "real runnable parents retain happy-path coverage")
+		}
+	}
+	_, err := os.Stat(counter)
+	require.True(t, os.IsNotExist(err), "hidden/overview nodes must not invoke a child Example")
+}
