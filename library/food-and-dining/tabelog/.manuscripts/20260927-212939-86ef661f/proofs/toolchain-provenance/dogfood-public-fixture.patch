+func TestLiveDogfoodBooleanAnnotationKeepsTypedArg(t *testing.T) {
+	command := liveDogfoodCommand{Path: []string{"remove"}, Help: "Usage:\n  fixture remove [flags]\n\nFlags:\n      --json Output JSON\n      --note string Personal note\n"}
+	for _, value := range []string{"true", "false"} {
+		args, err := overlayLiveDogfoodHappyArgs([]string{"remove"}, command, parseHappyArgsAnnotation("--json="+value+";--note="+value), t.TempDir())
+		require.NoError(t, err)
+		require.Equal(t, []string{"remove", "--json=" + value, "--note", value}, args)
+		if value == "false" {
+			require.False(t, liveDogfoodJSONRequested(args))
+			require.NotEqual(t, args, appendJSONArg(args), "false does not request JSON or qualify for exact-args reuse")
+		} else {
+			require.True(t, liveDogfoodJSONRequested(args))
+		}
+	}
+	require.False(t, liveDogfoodJSONRequested([]string{"remove", "--json=true", "--json=false"}))
+	require.NotEqual(t, []string{"remove", "--json=true", "--json=false"}, appendJSONArg([]string{"remove", "--json=true", "--json=false"}))
+}
