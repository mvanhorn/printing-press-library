+func restaurantSchemaType(v any) bool {
+	switch x := v.(type) {
+	case string:
+		return x == "Restaurant" || x == "https://schema.org/Restaurant" || x == "http://schema.org/Restaurant"
+	case []any:
+		for _, typ := range x {
+			if restaurantSchemaType(typ) {
+				return true
+			}
+		}
+	}
+	return false
+}
