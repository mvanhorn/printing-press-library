+// A requested URL is not evidence of the returned venue. Validate the page's
+// independent canonical/schema identity before any raw or normalized write.
+func validateDetailIdentity(doc *html.Node, schema map[string]any, requested string) error {
+	base, _ := url.Parse(requested)
+	verified := false
+	check := func(raw string, nodeReference bool) error {
+		raw = strings.TrimSpace(raw)
+		u, e := url.Parse(raw)
+		if e != nil || raw == "" {
+			return fail("parser_drift", "detail page has an invalid source-declared restaurant identity")
+		}
+		// A fragment-only schema @id names a node, not an independent venue route.
+		if u.Host == "" && (u.Path == "" || u.Path == "." || u.Path == "./") {
+			if nodeReference && u.Path == "" && u.RawQuery == "" && u.Fragment != "" {
+				return nil
+			}
+			return fail("parser_drift", "detail page has no independent source-declared restaurant identity route")
+		}
+		canonical, _, _, e := RestaurantURL(base.ResolveReference(u).String())
+		if e != nil {
+			return fail("parser_drift", "detail page has an invalid source-declared restaurant identity")
+		}
+		if canonical != requested {
+			return fail("constraint_mismatch", "source returned a different restaurant identity or canonical route")
+		}
+		verified = true
+		return nil
+	}
+	var identityErr error
+	walk(doc, func(n *html.Node) {
+		if identityErr != nil || n.Data != "link" {
+			return
+		}
+		for _, rel := range strings.Fields(attr(n, "rel")) {
+			if strings.EqualFold(rel, "canonical") {
+				identityErr = check(attr(n, "href"), false)
+				return
+			}
+		}
+	})
+	if identityErr != nil {
+		return identityErr
+	}
+	for _, key := range []string{"@id", "url"} {
+		if v, ok := schema[key]; ok {
+			raw, ok := v.(string)
+			if !ok {
+				return fail("parser_drift", "detail schema has an unrecognized restaurant identity value")
+			}
+			if e := check(raw, key == "@id"); e != nil {
+				return e
+			}
+		}
+	}
+	if !verified {
+		return fail("parser_drift", "detail page lost its source-declared canonical restaurant identity")
+	}
+	return nil
 }
 
