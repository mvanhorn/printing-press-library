+func selectedListingSort(l Listing) (string, error) {
+	active := 0
+	ranked := false
+	walk(l.Document, func(n *html.Node) {
+		if class(n, "navi-rstlst__tab") && class(n, "is-active") {
+			active++
+			ranked = class(n, "navi-rstlst__tab--rank") && strings.EqualFold(text(n), "Highest rated")
+		}
+	})
+	if active == 0 && len(l.Items) == 0 {
+		// Genuine empty pages omit sorting controls. No ordering is claimed.
+		return "not_applicable", nil
+	}
+	if active != 1 || !ranked {
+		return "", fail("constraint_mismatch", "source did not confirm the selected highest-rated ranking sort")
+	}
+	if l.NextURL != "" {
+		u, _ := url.Parse(l.NextURL)
+		if sort := u.Query().Get("SrtT"); sort != "" && sort != "rt" {
+			return "", fail("constraint_mismatch", "source next-page link changed the ranking sort")
+		}
+	}
+	return "highest_rated", nil
+}
