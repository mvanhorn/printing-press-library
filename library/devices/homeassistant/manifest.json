{
  "manifest_version": "0.3",
  "name": "homeassistant-pp-mcp",
  "display_name": "Homeassistant",
  "version": "4.2.2",
  "description": "Homeassistant API surface as MCP tools.",
  "author": {
    "name": "CLI Printing Press"
  },
  "license": "Apache-2.0",
  "server": {
    "type": "binary",
    "entry_point": "bin/homeassistant-pp-mcp",
    "mcp_config": {
      "command": "${__dirname}/bin/homeassistant-pp-mcp",
      "args": [],
      "env": {
        "HOMEASSISTANT_TOKEN": "${user_config.homeassistant_token}"
      }
    }
  },
  "user_config": {
    "homeassistant_token": {
      "type": "string",
      "title": "HOMEASSISTANT_TOKEN",
      "description": "Sets HOMEASSISTANT_TOKEN for the Homeassistant MCP server.",
      "sensitive": true,
      "required": true
    }
  },
  "compatibility": {
    "claude_desktop": ">=1.0.0",
    "platforms": [
      "darwin",
      "linux",
      "win32"
    ]
  }
}
