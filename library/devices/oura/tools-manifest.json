{
  "api_name": "oura",
  "base_url": "https://api.ouraring.com",
  "description": "The only Oura Ring CLI that remembers everything: sync all metrics to local SQLite, correlate habits with scores, detect anomalies, and alert on multi-day recovery deficits no app can surface.",
  "mcp_ready": "full",
  "http_transport": "standard",
  "auth": {
    "type": "bearer_token",
    "header": "Authorization",
    "format": "Bearer {OURA_ACCESS_TOKEN}",
    "in": "header",
    "env_vars": [
      "OURA_ACCESS_TOKEN"
    ],
    "env_var_specs": [
      {
        "name": "OURA_ACCESS_TOKEN",
        "kind": "per_call",
        "required": true,
        "sensitive": true,
        "inferred": true
      }
    ]
  },
  "required_headers": [],
  "tools": [
    {
      "name": "daily-activity_list",
      "description": "List daily activity summaries. Optional: start_date, end_date, next_token. Returns array of DailyActivity.",
      "method": "GET",
      "path": "/v2/usercollection/daily_activity",
      "params": [
        {
          "name": "start_date",
          "type": "string",
          "location": "query",
          "description": "Start date (YYYY-MM-DD)"
        },
        {
          "name": "end_date",
          "type": "string",
          "location": "query",
          "description": "End date (YYYY-MM-DD)"
        },
        {
          "name": "next_token",
          "type": "string",
          "location": "query",
          "description": "Pagination cursor"
        }
      ]
    },
    {
      "name": "daily-cardiovascular-age_list",
      "description": "List daily cardiovascular age estimates. Optional: start_date, end_date, next_token. Returns array of DailyCardiovascularAge.",
      "method": "GET",
      "path": "/v2/usercollection/daily_cardiovascular_age",
      "params": [
        {
          "name": "start_date",
          "type": "string",
          "location": "query",
          "description": "Start date (YYYY-MM-DD)"
        },
        {
          "name": "end_date",
          "type": "string",
          "location": "query",
          "description": "End date (YYYY-MM-DD)"
        },
        {
          "name": "next_token",
          "type": "string",
          "location": "query",
          "description": "Pagination cursor"
        }
      ]
    },
    {
      "name": "daily-readiness_list",
