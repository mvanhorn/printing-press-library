        },
        {
          "name": "end_date",
          "type": "string",
          "location": "query",
          "description": "End date (YYYY-MM-DD)"
        },
        {
          "name": "next_token",
          "type": "string",
          "location": "query",
          "description": "Pagination cursor"
        }
      ]
    },
