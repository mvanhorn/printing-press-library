    {
      "name": "webhook-subscription_create",
      "description": "Create a webhook subscription. Required: callback_url, event_type, data_type. Returns the new WebhookSubscription.",
      "method": "POST",
      "path": "/v2/webhook/subscription",
      "params": [
        {
          "name": "callback_url",
          "type": "string",
          "location": "body",
          "description": "HTTPS URL to receive webhook events",
          "required": true
        },
        {
          "name": "event_type",
          "type": "string",
          "location": "body",
          "description": "Event type to subscribe to (e.g. create, update, delete)",
          "required": true
        },
        {
          "name": "data_type",
          "type": "string",
          "location": "body",
          "description": "Data type to receive events for",
          "required": true
        }
      ]
    },
    {
      "name": "webhook-subscription_delete",
      "description": "Delete a webhook subscription. Required: id. Returns the DeleteResponse. Destructive.",
      "method": "DELETE",
      "path": "/v2/webhook/subscription/{id}",
      "params": [
        {
          "name": "id",
          "type": "string",
          "location": "path",
          "description": "Subscription ID",
          "required": true
        }
      ]
    },
    {
      "name": "webhook-subscription_list",
      "description": "List webhook subscriptions. Returns array of WebhookSubscription.",
      "method": "GET",
      "path": "/v2/webhook/subscription",
      "params": []
    },
    {
      "name": "workout_list",
      "description": "List workout sessions. Optional: start_date, end_date, next_token. Returns array of Workout.",
