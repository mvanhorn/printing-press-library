      "name": "enhanced-tag_list",
      "description": "List enhanced tags (user annotations with optional text). Optional: start_date, end_date, next_token. Returns array of EnhancedTag.",
      "method": "GET",
      "path": "/v2/usercollection/enhanced_tag",
      "params": [
        {
          "name": "start_date",
          "type": "string",
          "location": "query",
