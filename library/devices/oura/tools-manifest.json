        },
        {
          "name": "next_token",
          "type": "string",
          "location": "query",
          "description": "Pagination cursor"
        }
      ]
    },
    {
      "name": "heartrate_list",
      "description": "List heart rate samples for a datetime range (up to 5-min resolution). Optional: start_datetime, end_datetime, next_token. Returns array of HeartRate.",
      "method": "GET",
      "path": "/v2/usercollection/heartrate",
      "params": [
        {
          "name": "start_datetime",
          "type": "string",
          "location": "query",
          "description": "Start datetime (ISO 8601, e.g. 2026-06-15T00:00:00+00:00)"
        },
        {
          "name": "end_datetime",
          "type": "string",
          "location": "query",
          "description": "End datetime (ISO 8601)"
        },
        {
          "name": "next_token",
          "type": "string",
          "location": "query",
          "description": "Pagination cursor"
        }
      ]
    },
    {
      "name": "personal-info_get",
      "description": "Fetch the authenticated user's personal profile from Oura. No parameters. Returns id, age (years), weight (kg), height (m), and biological_sex. Use this for the static demographics behind derived metrics (e.g. VO2 max, calorie estimates) rather than for daily readiness or activity data, which come from the daily-* commands.",
      "method": "GET",
      "path": "/v2/usercollection/personal_info",
      "params": []
    },
    {
      "name": "rest-mode-period_list",
