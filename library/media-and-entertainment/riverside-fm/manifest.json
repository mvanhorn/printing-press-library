{
  "manifest_version": "0.3",
  "name": "riverside-fm-pp-mcp",
  "display_name": "Riverside",
  "version": "4.4.0",
  "description": "Riverside API surface as MCP tools.",
  "author": {
    "name": "CLI Printing Press"
  },
  "license": "Apache-2.0",
