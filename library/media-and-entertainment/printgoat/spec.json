    "creations": {
      "description": "Cults3D creations (designs)",
      "base_url": "https://cults3d.com",
      "endpoints": {
        "get": {
          "method": "POST",
          "path": "/graphql",
          "description": "Get a Cults3D creation's detail",
          "params": [
            {
              "default": null,
              "description": "Cults3D creation slug",
              "fields": null,
              "name": "slug",
              "positional": true,
              "required": true,
              "type": "string"
            }
          ],
          "body": [
            {
              "name": "query",
              "body_name": "query",
              "type": "string",
              "required": true,
              "positional": false,
              "default": "query GetCreation($slug: String!) {\n  model: creation(slug: $slug) {\n    identifier\n    name\n    shortUrl\n    likesCount\n    downloadsCount\n    viewsCount\n    publishedAt\n    category { name }\n    license { code name }\n    creator { nick shortUrl }\n  }\n}\n",
              "description": "",
              "fields": null,
              "dispatch_param": true
            },
            {
              "body_name": "variables",
              "default": null,
              "description": "",
              "fields": [
                {
                  "default": null,
                  "description": "Cults3D creation slug",
                  "fields": null,
                  "name": "slug",
                  "positional": false,
                  "required": true,
                  "type": "string"
                }
              ],
              "name": "variables",
              "positional": false,
              "required": false,
              "type": "object"
            }
          ],
          "response": {
            "type": "object",
            "item": "Cults3DCreationDetail"
          },
          "pagination": null,
          "response_path": "data.model",
          "tier": "cults3d"
        },
        "search": {
          "method": "POST",
          "path": "/graphql",
          "description": "Search Cults3D creations by keyword",
          "params": [
            {
              "default": null,
              "description": "Search keywords",
              "fields": null,
              "name": "query",
              "positional": true,
              "required": true,
              "type": "string"
            }
          ],
          "body": [
            {
              "name": "query",
              "body_name": "query",
              "type": "string",
              "required": true,
              "positional": false,
              "default": "query SearchCreations($query: String!, $limit: Int, $offset: Int) {\n  result: creationsSearchBatch(query: $query, limit: $limit, offset: $offset) {\n    identifier\n    name\n    shortUrl\n    likesCount\n    downloadsCount\n    publishedAt\n    creator { nick shortUrl }\n  }\n}\n",
              "description": "",
              "fields": null,
              "dispatch_param": true
            },
            {
              "body_name": "variables",
              "default": null,
              "description": "",
              "fields": [
                {
                  "default": null,
                  "description": "Search keywords",
                  "fields": null,
                  "name": "query",
                  "positional": false,
                  "required": true,
                  "type": "string"
                },
                {
                  "default": 20,
                  "description": "",
                  "fields": null,
                  "name": "limit",
                  "positional": false,
                  "required": false,
                  "type": "integer"
                },
                {
                  "default": 0,
                  "description": "",
                  "fields": null,
                  "name": "offset",
                  "positional": false,
                  "required": false,
                  "type": "integer"
                }
              ],
              "name": "variables",
              "positional": false,
              "required": false,
              "type": "object"
            }
          ],
          "response": {
            "type": "array",
            "item": "Cults3DCreation"
          },
          "pagination": null,
          "response_path": "data.result",
          "tier": "cults3d"
        }
      }
    },
    "models": {
      "description": "Printables 3D models (prints)",
      "endpoints": {
        "get": {
          "method": "POST",
          "path": "/graphql/",
          "description": "Get a Printables model's detail and file listing",
          "params": [
            {
              "default": null,
              "description": "Printables model ID",
              "fields": null,
              "name": "id",
              "positional": true,
              "required": true,
              "type": "string"
            }
          ],
          "body": [
            {
              "name": "query",
              "body_name": "query",
              "type": "string",
              "required": true,
              "positional": false,
              "default": "query ModelDetail($id: ID!) {\n  model: print(id: $id) {\n    id\n    name\n    slug\n    filesType\n    ratingAvg\n    likesCount\n    downloadCount\n    datePublished\n    user { id handle publicUsername }\n    stls { id name fileSize }\n    gcodes { id name fileSize }\n    slas { id name fileSize }\n    otherFiles { id name fileSize }\n  }\n}\n",
              "description": "",
              "fields": null,
              "dispatch_param": true
            },
            {
              "body_name": "variables",
              "default": null,
              "description": "",
              "fields": [
                {
                  "default": null,
                  "description": "Printables model ID",
                  "fields": null,
                  "name": "id",
                  "positional": false,
                  "required": true,
                  "type": "string"
                }
              ],
              "name": "variables",
              "positional": false,
              "required": false,
              "type": "object"
            }
          ],
          "response": {
            "type": "object",
            "item": "PrintablesModelDetail"
          },
          "pagination": null,
          "response_path": "data.model",
          "no_auth": true
        }
      }
    },
