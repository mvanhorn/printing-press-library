{
  "manifest_version": "0.3",
  "name": "immich-pp-mcp",
  "display_name": "Immich",
  "version": "3.0.3",
  "description": "Agent-native control and careful personal-library rituals for a self-hosted Immich instance.",
  "author": {
    "name": "CLI Printing Press"
  },
  "license": "Apache-2.0",
  "server": {
    "type": "binary",
    "entry_point": "bin/immich-pp-mcp",
    "mcp_config": {
      "command": "${__dirname}/bin/immich-pp-mcp",
      "args": [],
      "env": {
        "IMMICH_API_KEY": "${user_config.immich_api_key}"
      }
    }
  },
  "user_config": {
    "immich_api_key": {
      "type": "string",
      "title": "IMMICH_API_KEY",
      "description": "Sets IMMICH_API_KEY for the Immich MCP server.",
      "sensitive": true,
      "required": true
    }
  },
  "compatibility": {
    "claude_desktop": ">=1.0.0",
    "platforms": [
      "darwin",
      "linux",
      "win32"
    ]
  }
}
