+		"warnings": {"transfers": []map[string]any{{"x": 1}}, "warnings": []any{}},
+	} {
+		t.Run(name, func(t *testing.T) {
+			buf := &bytes.Buffer{}
+			cmd := &cobra.Command{}
+			cmd.SetOut(buf)
+			if err := (&rootFlags{csv: true}).emitStructured(cmd, in); err != nil {
+				t.Fatal(err)
+			}
+			if got := strings.TrimSpace(buf.String()); got != "x\n1" {
+				t.Fatalf("CSV = %q", got)
+			}
+		})
+	}
+}
