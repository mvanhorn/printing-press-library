					Payment:      e.Payment,
				})
				for _, u := range e.Users {
					key := balKey{UserID: u.UserID, CurrencyCode: strings.TrimSpace(e.CurrencyCode)}
					running[key] += parseAmount(u.PaidShare) - parseAmount(u.OwedShare)
					if _, ok := memberNames[u.UserID]; !ok {
