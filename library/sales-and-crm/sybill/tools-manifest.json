{
  "api_name": "sybill",
  "base_url": "https://api.sybill.ai",
  "description": "The first CLI for Sybill: every conversation, deal, and account in your terminal, plus a local store that answers cross-entity questions the web UI can't.",
  "mcp_ready": "full",
  "http_transport": "standard",
  "auth": {
    "type": "bearer_token",
    "header": "Authorization",
    "env_vars": [
      "SYBILL_API_KEY"
    ],
    "env_var_specs": [
      {
        "name": "SYBILL_API_KEY",
        "kind": "per_call",
        "required": true,
        "sensitive": true,
        "inferred": true
      }
    ]
  },
  "required_headers": [],
  "tools": [
    {
      "name": "accounts_get",
      "description": "Get the detailed view for a single account. Required: accountId. Returns array of AccountContact.",
      "method": "GET",
      "path": "/v1/accounts/{accountId}",
      "params": [
        {
          "name": "accountId",
          "type": "string",
          "location": "path",
          "description": "Account id",
          "required": true
        }
      ]
    },
    {
      "name": "accounts_list",
      "description": "List accounts accessible to the API key's organization. Optional: name, website, owner (plus 6 more). Returns array of AccountListItem.",
      "method": "GET",
      "path": "/v1/accounts",
      "params": [
        {
          "name": "name",
          "type": "string",
          "location": "query",
          "description": "Filter by account name (case-insensitive partial match)"
        },
        {
          "name": "website",
          "type": "string",
          "location": "query",
          "description": "Filter by website URL (case-insensitive partial match)"
        },
        {
          "name": "owner",
          "type": "string",
          "location": "query",
          "description": "Filter by owner name or email (case-insensitive partial match)"
        },
        {
          "name": "createdBefore",
          "type": "string",
          "location": "query",
          "description": "Upper bound for created date (ISO 8601, e.g. 2025-06-30T00:00:00Z)"
        },
        {
          "name": "createdAfter",
          "type": "string",
          "location": "query",
          "description": "Lower bound for created date (ISO 8601)"
        },
        {
          "name": "lastActivityBefore",
          "type": "string",
          "location": "query",
          "description": "Upper bound for last activity date (ISO 8601)"
        },
        {
          "name": "lastActivityAfter",
          "type": "string",
          "location": "query",
          "description": "Lower bound for last activity date (ISO 8601)"
        },
        {
          "name": "limit",
          "type": "int",
          "location": "query",
          "description": "Maximum number of results per page (1-50)"
        },
        {
          "name": "cursor",
          "type": "string",
          "location": "query",
          "description": "Opaque pagination cursor from a previous response"
        }
      ]
    },
