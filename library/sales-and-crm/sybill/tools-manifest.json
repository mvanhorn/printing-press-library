    {
      "name": "conversations_list",
      "description": "List conversations accessible to the API key's organization. Optional: limit (default: 20), startedAfter, startedBefore (plus 6 more). Returns array of ConversationListItem.",
      "method": "GET",
      "path": "/v1/conversations",
      "params": [
        {
          "name": "limit",
          "type": "int",
          "location": "query",
          "description": "Maximum number of results per page (1-50)"
        },
        {
          "name": "startedAfter",
          "type": "string",
          "location": "query",
          "description": "Lower bound for meeting start time (ISO 8601)"
        },
        {
          "name": "startedBefore",
          "type": "string",
          "location": "query",
          "description": "Upper bound for meeting start time (ISO 8601)"
        },
        {
          "name": "type",
          "type": "string",
          "location": "query",
          "description": "Filter by meeting type (e.g. EXTERNAL, INTERNAL)"
        },
        {
          "name": "title",
          "type": "string",
          "location": "query",
          "description": "Filter by meeting title (case-insensitive partial match)"
        },
        {
          "name": "attendees",
          "type": "string",
          "location": "query",
          "description": "Filter by an attendee. Accepts three shapes: a participant name fragment (e.g. `John`, case-insensitive partial match), a full participant email (e.g. `alice@acme.com`, exact match), or a participant company domain (e.g. `@acme.com` or `acme.com`, exact match against the email domain)."
        },
        {
          "name": "crmName",
          "type": "string",
          "location": "query",
          "description": "Filter by associated CRM deal or account name (case-insensitive exact-phrase match). Multi-word queries match the full phrase, not individual tokens."
        },
        {
          "name": "sourceId",
          "type": "string",
          "location": "query",
          "description": "Filter by conversation origin. Accepts a reserved native string (e.g. `sybill`, `gong`, `chorus`, `fathom`, `grain`, `mindtickle`, `avoma`, `fireflies`, `zoho_meetings`, `uploaded_call`, `uploaded_transcript`, `sdk_upload`, `zoom_phone`, `outreach_dialer`), or a public-API ``IngestSource`` UUID to narrow to conversations ingested through that source. Omitted means all origins."
        },
        {
          "name": "cursor",
          "type": "string",
          "location": "query",
          "description": "Opaque pagination cursor from a previous response"
        }
      ]
    },
