{
  "manifest_version": "0.3",
  "name": "unify-data-pp-mcp",
  "display_name": "Unify Data",
  "version": "4.3.0",
  "description": "Unify Data API surface as MCP tools.",
  "author": {
    "name": "CLI Printing Press"
  },
  "license": "Apache-2.0",
  "server": {
    "type": "binary",
    "entry_point": "bin/unify-data-pp-mcp",
    "mcp_config": {
      "command": "${__dirname}/bin/unify-data-pp-mcp",
      "args": [],
      "env": {
        "UNIFY_API_KEY": "${user_config.unify_api_key}"
      }
    }
  },
  "user_config": {
    "unify_api_key": {
      "type": "string",
      "title": "UNIFY_API_KEY",
      "description": "Sets UNIFY_API_KEY for the Unify Data MCP server.",
      "sensitive": true,
      "required": true
    }
  },
  "compatibility": {
    "claude_desktop": ">=1.0.0",
    "platforms": [
      "darwin",
      "linux",
      "win32"
    ]
  }
}
