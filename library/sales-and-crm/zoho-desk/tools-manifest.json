{
  "api_name": "zoho-desk",
  "base_url": "https://desk.zoho.com/api/v1",
  "description": "The only scriptable, agent-native CLI for Zoho Desk: every ticket operation plus a local SQLite store, offline search, and SLA/triage analytics no help-desk tool ships.",
  "mcp_ready": "full",
  "http_transport": "standard",
  "mcp": {
    "endpoint_tools": "hidden",
    "orchestration": "code"
  },
  "auth": {
    "type": "oauth2_refresh",
    "header": "Authorization",
    "format": "Zoho-oauthtoken {ZOHO_DESK_CLIENT_ID}",
    "env_vars": [
      "ZOHO_DESK_CLIENT_ID",
      "ZOHO_DESK_CLIENT_SECRET",
      "ZOHO_DESK_REFRESH_TOKEN"
    ],
    "env_var_specs": [
      {
        "name": "ZOHO_DESK_CLIENT_ID",
        "kind": "auth_flow_input",
        "required": true,
        "sensitive": false,
        "inferred": true
      },
      {
        "name": "ZOHO_DESK_CLIENT_SECRET",
        "kind": "auth_flow_input",
        "required": false,
        "sensitive": true,
        "inferred": true
      },
      {
        "name": "ZOHO_DESK_REFRESH_TOKEN",
        "kind": "auth_flow_input",
        "required": true,
        "sensitive": true,
        "inferred": true
      }
    ]
  },
