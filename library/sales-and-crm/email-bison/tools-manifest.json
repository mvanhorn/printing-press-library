{
  "api_name": "email-bison",
  "base_url": "https://dedi.emailbison.com",
  "description": "Every Email Bison campaign, lead, and reply on the command line, plus a local database and cross-entity analytics no other Email Bison tool has.",
  "mcp_ready": "full",
  "http_transport": "standard",
  "auth": {
    "type": "bearer_token",
    "header": "Authorization",
    "env_vars": [
      "EMAIL_BISON_API_KEY"
    ],
    "env_var_specs": [
      {
        "name": "EMAIL_BISON_API_KEY",
        "kind": "per_call",
        "required": true,
        "sensitive": true,
        "description": "Email Bison workspace api-user token from Settings -\u003e Developer API."
      }
    ]
  },
  "required_headers": [],
  "tools": [
    {
      "name": "campaigns_create",
      "description": "Create a campaign. Returns the new campaign ID. Required: name.",
      "method": "POST",
      "path": "/api/campaigns",
      "params": [
        {
          "name": "name",
          "type": "string",
          "location": "body",
          "description": "Name of the campaign.",
          "required": true
        }
      ]
    },
    {
      "name": "campaigns_delete-sequence-step",
      "description": "Delete a sequence step. Required: id. Destructive.",
      "method": "DELETE",
      "path": "/api/campaigns/sequence-steps/{id}",
      "params": [
        {
          "name": "id",
          "type": "int",
          "location": "path",
          "description": "Sequence step ID.",
          "required": true
        }
      ]
    },
    {
      "name": "campaigns_get",
      "description": "Get a campaign and its settings. Required: id.",
      "method": "GET",
      "path": "/api/campaigns/{id}",
      "params": [
        {
          "name": "id",
          "type": "int",
          "location": "path",
          "description": "Campaign ID.",
          "required": true
        }
      ]
    },
    {
      "name": "campaigns_list",
      "description": "List campaigns in the workspace. Optional: search, page (default: 1), pagination_type (default: page) (plus 1 more).",
      "method": "GET",
      "path": "/api/campaigns",
      "params": [
        {
          "name": "search",
          "type": "string",
          "location": "query",
          "description": "Free-text search filter."
        },
        {
          "name": "page",
          "type": "int",
          "location": "query",
          "description": "Page number for page-based pagination (capped at 1000 pages)."
        },
        {
          "name": "pagination_type",
          "type": "string",
          "location": "query",
          "description": "Use cursor for large datasets."
        },
        {
          "name": "cursor",
          "type": "string",
          "location": "query",
          "description": "Opaque cursor from meta.next_cursor when pagination_type=cursor."
        }
      ]
    },
    {
