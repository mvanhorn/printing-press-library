{
  "api_name": "servicetitan-salestech",
  "base_url": "https://api.servicetitan.io/sales/v2",
  "description": "Estimates",
  "mcp_ready": "full",
  "http_transport": "standard",
  "auth": {
    "type": "bearer_token",
    "header": "Authorization",
    "env_vars": [
      "ST_CLIENT_ID",
      "ST_CLIENT_SECRET"
    ],
    "env_var_specs": [
      {
        "name": "ST_CLIENT_ID",
        "kind": "auth_flow_input",
        "required": true,
        "sensitive": true,
        "description": "ServiceTitan OAuth2 client_id for the integration. Used by the auth login flow to exchange for a bearer token at https://auth.servicetitan.io/connect/token. Whitespace is stripped defensively."
      },
      {
        "name": "ST_CLIENT_SECRET",
        "kind": "auth_flow_input",
        "required": true,
        "sensitive": true,
        "description": "ServiceTitan OAuth2 client_secret paired with ST_CLIENT_ID. Whitespace is stripped defensively (a known JKA env gotcha that produced opaque invalid_client 400s)."
      }
    ]
  },
  "required_headers": [],
  "tools": [
    {
      "name": "estimates_create",
      "description": "Estimates_create. Required: tenant. Optional: budgetCodeId, externalLinks, isRecommended (plus 11 more). Returns the new EstimatesV2EstimateResponse.",
      "method": "POST",
      "path": "/tenant/{tenant}/estimates",
      "params": [
        {
          "name": "tenant",
          "type": "int",
          "location": "path",
          "description": "Tenant ID",
          "required": true
        },
        {
          "name": "budgetCodeId",
          "type": "int",
          "location": "body",
          "description": "Budget code id"
        },
        {
          "name": "externalLinks",
          "type": "array",
          "location": "body",
          "description": "External links"
        },
        {
          "name": "isRecommended",
          "type": "bool",
          "location": "body",
          "description": "Is recommended"
        },
        {
          "name": "items",
          "type": "array",
          "location": "body",
          "description": "Items"
        },
        {
          "name": "jobId",
          "type": "int",
          "location": "body",
          "description": "Job id"
        },
        {
          "name": "locationId",
          "type": "int",
          "location": "body",
          "description": "Location id"
        },
        {
          "name": "name",
          "type": "string",
          "location": "body",
          "description": "Name"
        },
        {
          "name": "projectId",
          "type": "int",
          "location": "body",
          "description": "Project id"
        },
        {
          "name": "reviewStatus",
          "type": "string",
          "location": "body",
          "description": "Review status"
        },
        {
          "name": "soldBy",
          "type": "int",
          "location": "body",
          "description": "Sold by"
        },
        {
          "name": "status",
          "type": "string",
          "location": "body",
          "description": "Status"
        },
        {
          "name": "summary",
          "type": "string",
          "location": "body",
          "description": "Summary"
        },
        {
          "name": "tax",
          "type": "float",
          "location": "body",
          "description": "Tax"
        },
        {
          "name": "useDefaultProjectLabels",
          "type": "bool",
          "location": "body",
          "description": "Use default project labels"
        }
      ]
    },
    {
      "name": "estimates_export-async-legacy",
      "description": "Provides export feed for estimates (legacy endpoint). Required: tenant. Optional: from, includeRecentChanges. Returns array of EstimatesV2ExportEstimatesResponse.",
      "method": "GET",
      "path": "/tenant/{tenant}/estimates/export",
      "params": [
        {
          "name": "tenant",
          "type": "int",
          "location": "path",
          "description": "Tenant ID",
          "required": true
        },
        {
          "name": "from",
          "type": "string",
          "location": "query",
          "description": "Continuation token received from previous export request in 'continueFrom' field. When not specified, the export process starts from the beginning. Use custom date strings, e.g. '2020-01-01' to start the export process from the certain point in time."
        },
        {
          "name": "includeRecentChanges",
          "type": "bool",
          "location": "query",
          "description": "Use 'true' to start receiving the most recent changes quicker. Note this may cause the same results appearing multiple times on consecutive requests."
        }
      ]
    },
    {
      "name": "estimates_get",
